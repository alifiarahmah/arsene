    {
      "id": "AUTH-CHAIN-1",
      "hypothesis_id": "auth_flow_validation",
      "base_url": "http://",
      "method": "POST",
      "endpoint": "/rest/user/login",
      "parameter": "",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "body",
              "value": "dummy@mail.com"
            },
            {
              "location": "body",
              "value": "dummy"
            }
          ],
          "description": "Perform form-login to obtain auth session / JWT for subsequent tests.",
          "encoding": "json",
          "content_type": "application/json",
          "header": []
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "Expect 200 or redirect indicating successful login and issuance of auth token in response body or Set-Cookie header.",
          "threshold": {
            "expected_codes": [
              200,
              302
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "sensitive_data_exposed",
          "condition": "Response contains JWT or user identifying fields (email, id) usable for subsequent requests.",
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 5
      },
      "max_retries": 1,
      "delay_between_requests": 1.0,
      "notes": "High-priority prerequisite to enable authenticated chains; use observed sample credentials.",
      "tags": [
        "auth"
      ],
      "estimated_duration": 60
    },
