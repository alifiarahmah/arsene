    {
      "id": "TC-GET-Challenges-xss",
      "hypothesis_id": "GET-5-xss_reflected",
      "base_url": "http://",
      "method": "GET",
      "endpoint": "/api/Challenges",
      "parameter": "name",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query",
              "value": "Score%20Board"
            }
          ],
          "description": "Baseline benign value to observe normal response.",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "%3Cscript%3E__TEST_XSS__%3C%2Fscript%3E"
            }
          ],
          "description": "Probe for reflection of script tag in JSON response (encoded).",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "%22%3E%3Cimg%20src=x%20onerror=__TEST_XSS__%3E"
            }
          ],
          "description": "Alternate injection encoded to detect weak HTML escaping in downstream clients.",
          "content_type": "application/json",
          "header": []
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "Injected 'name' parameter value appears verbatim in response body or in returned JSON fields.",
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "Response length changes by >=10% between benign and injected 'name' values.",
          "threshold": {
            "body_length_delta_pct": 10.0
          },
          "weight": 0.5
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 50
      },
      "max_retries": 3,
      "delay_between_requests": 0.5,
      "notes": "Do not execute payloads in browser. Stop on any reflection signal.",
      "tags": [
        "xss",
        "reflected"
      ],
      "estimated_duration": 120
    },
