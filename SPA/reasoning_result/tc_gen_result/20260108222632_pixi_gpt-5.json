    {
      "id": "tc-hyp-POST-16-others-multipart-1",
      "hypothesis_id": "hyp-POST-16-others-multipart",
      "base_url": "http",
      "method": "POST",
      "endpoint": "/upload_photo/",
      "parameter": "multipart/form-data",
      "payloads": [
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "------WebKitFormBoundaryUzCwPZQIC5FBFc1k\r\nContent-Disposition: form-data; name=\"file\"; filename=\"test.jpg\"\r\nContent-Type: image/jpeg\r\n\r\nJFIFDATA\r\n------WebKitFormBoundaryUzCwPZQIC5FBFc1k--"
            }
          ],
          "description": "Well-formed minimal multipart using observed boundary",
          "content_type": "multipart/form-data; boundary=----WebKitFormBoundaryUzCwPZQIC5FBFc1k",
          "header": [
            {
              "header_name": "Expect",
              "header_value": "100-continue"
            }
          ]
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "------WebKitFormBoundaryUzCwPZQIC5FBFc1k\r\nContent-Disposition: form-data; name=\"file\"; filename=\"test.jpg\"\r\nContent-Type: image/jpeg\r\n\r\n\r\n"
            }
          ],
          "description": "Malformed: missing closing boundary",
          "content_type": "multipart/form-data; boundary=----WebKitFormBoundaryUzCwPZQIC5FBFc1k",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "--BADBOUNDARY\r\nContent-Disposition: form-data; name=\"file\"; filename=\"x.txt\"\r\nContent-Type: text/plain\r\n\r\nx\r\n--BADBOUNDARY--"
            }
          ],
          "description": "Malformed: wrong boundary",
          "content_type": "multipart/form-data; boundary=BADBOUNDARY",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "------WebKitFormBoundaryUzCwPZQIC5FBFc1k\r\nContent-Disposition: form-data; name=\"file\"; filename=\"x.php\"\r\nContent-Type: application/octet-stream\r\n\r\n<?php echo 1; ?>\r\n------WebKitFormBoundaryUzCwPZQIC5FBFc1k--"
            }
          ],
          "description": "Executable extension to test validation",
          "content_type": "multipart/form-data; boundary=----WebKitFormBoundaryUzCwPZQIC5FBFc1k",
          "header": []
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "response.status in [200,201,202,204] for malformed or dangerous cases",
          "threshold": {
            "expected_codes": [
              200,
              201,
              202,
              204
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "error_signature",
          "condition": "regex_search(response.body, '(StackTrace|Traceback|IllegalState|Multipart|boundary|parser|exception)') or any(hv[0]==\"X-Powered-By\" for hv in response.headers)",
          "threshold": {},
          "weight": 0.6
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 6
      },
      "max_retries": 1,
      "delay_between_requests": 0.3,
      "tags": [
        "multipart",
        "upload",
        "validation"
      ],
