      "id": "TC-H-011-1",
      "hypothesis_id": "H-011",
      "base_url": "http://example.local",
      "method": "POST",
      "endpoint": "/upload_photo/",
      "parameter": "file",
      "payloads": [
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "--boundary\r\nContent-Disposition: form-data; name=\"file\"; filename=\"test.txt\"\r\nContent-Type: text/plain\r\n\r\n<%E0%80%80%>\r\n--boundary--"
            }
          ],
          "description": "Multipart upload with unusual bytes to trigger parser errors",
          "content_type": "multipart/form-data; boundary=boundary",
          "header": []
        },
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "body",
              "value": "--boundary\r\nContent-Disposition: form-data; name=\"file\"; filename=\"photo.jpg\"\r\nContent-Type: image/jpeg\r\n\r\nJPEGDATA\r\n--boundary--"
            }
          ],
          "description": "Valid multipart upload control to compare responses",
          "content_type": "multipart/form-data; boundary=boundary",
          "header": []
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "error_signature",
          "condition": "response status in [400,413,415,500] or body contains parsing/stack-trace indicators",
          "threshold": {
            "expected_codes": [
              400,
              413,
              415,
              500
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "status_code_change",
          "condition": "Observed status code not equal to expected 200/201 for valid upload or unexpected codes for probe",
          "threshold": {
            "expected_codes": [
              200,
              201,
              400,
              413,
              415,
              500
            ]
          },
          "weight": 0.8
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 20
      },
      "max_retries": 2,
      "delay_between_requests": 1.0,
      "tags": [
        "file-upload",
        "parsing"
      ],
      "estimated_duration": 120
