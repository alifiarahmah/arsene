    {
      "id": "TC-H-001-1",
      "hypothesis_id": "H-001",
      "base_url": "http://example.local",
      "method": "GET",
      "endpoint": "/login",
      "parameter": "user",
      "payloads": [
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "<script>1</script>"
            }
          ],
          "description": "Reflected XSS probe with simple script tag",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "\"onmouseover=alert(1) x=\""
            }
          ],
          "description": "Attribute context probe to detect HTML attribute reflection",
          "header": []
        },
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query",
              "value": "normaluser@mail.com"
            }
          ],
          "description": "Control request using normal value to compare response length",
          "header": []
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "response body contains payload value or HTML-escaped variant",
          "threshold": {
            "body_length_delta_pct": 5.0
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "response body length differs by >=10% between control and probe requests",
          "threshold": {
            "body_length_delta_pct": 10.0
          },
          "weight": 0.8
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 20
      },
      "max_retries": 2,
      "delay_between_requests": 0.5,
      "tags": [
        "xss",
        "reflected",
        "login"
      ],
      "estimated_duration": 60
    },
