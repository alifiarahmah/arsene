{
  "test_cases": [
    {
      "id": "PLAN-1-CSRF-Validation",
      "hypothesis_id": "H7",
      "base_url": "https",
      "method": "POST",
      "endpoint": "14",
      "parameter": "csrf",
      "payloads": [
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": ""
            }
          ],
          "description": "Missing CSRF token",
          "encoding": "json",
          "content_type": "application/json; charset=utf-8",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "invalidtoken"
            }
          ],
          "description": "Invalid CSRF token",
          "encoding": "json",
          "content_type": "application/json; charset=utf-8",
          "header": []
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "expect_rejection_without_valid_csrf",
          "threshold": {
            "expected_codes": [
              200,
              400,
              403
            ]
          },
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 3
      },
      "max_retries": 1,
      "delay_between_requests": 0.2,
      "notes": "Pre-check CSRF enforcement to decide whether to fetch/bind token for subsequent POST tests. Stop email-based attacks if CSRF strictly enforced with 403 for invalid/missing.",
      "tags": [
        "csrf",
        "subscribe",
        "gatekeeper"
      ]
    },
    {
      "id": "PLAN-2-Subscribe-XSS",
      "hypothesis_id": "H5",
      "base_url": "https",
      "method": "POST",
      "endpoint": "14",
      "parameter": "email",
      "payloads": [
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "mail@example.com"
            }
          ],
          "description": "Baseline valid email",
          "encoding": "json",
          "content_type": "application/json; charset=utf-8",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "<img src=x onerror=alert(1)>@example.com"
            }
          ],
          "description": "XSS probe in local-part of email",
          "encoding": "json",
          "content_type": "application/json; charset=utf-8",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "\"/><svg/onload=alert(1)>@example.com"
            }
          ],
          "description": "Breaking out and injecting HTML/JS",
          "encoding": "json",
          "content_type": "application/json; charset=utf-8",
          "header": []
        }
      ],
      "prerequisites": [
        {
          "type": "csrf_token",
          "description": "Obtain CSRF token value from prior GET form/source",
          "extract_from": "prior_response",
          "bind_to": "csrf"
        }
      ],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "observe_followup_gets",
          "threshold": {
            "string_value": "payload_appears_unencoded"
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "delta_vs_baseline_followup",
          "threshold": {
            "body_length_delta_pct": 20.0
          },
          "weight": 1.0
        },
        {
          "signal": "status_code_change",
          "condition": "write_acceptance_vs_rejection",
          "threshold": {
            "expected_codes": [
              200,
              201,
              202,
              400,
              422
            ]
          },
          "weight": 0.5
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 4
      },
      "max_retries": 1,
      "delay_between_requests": 0.3,
      "notes": "Execute only if PLAN-1 indicates CSRF can be satisfied (token obtained) or is weak. Use same session for follow-up GETs to detect stored/reflected output.",
      "tags": [
        "xss_stored",
        "subscribe",
        "stateful_flow"
      ]
    },
    {
      "id": "PLAN-3-Subscribe-SQLi",
      "hypothesis_id": "H6",
      "base_url": "https",
      "method": "POST",
      "endpoint": "14",
      "parameter": "email",
      "payloads": [
        {
          "tier": "probe",
