            {
              "location": "body",
              "value": "mail@example.com'"
            }
          ],
          "description": "Quote termination for SQLi",
          "encoding": "json",
          "content_type": "application/json; charset=utf-8",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "mail@example.com' OR 1=1 --"
            }
          ],
          "description": "Boolean-based SQLi in email field",
          "encoding": "json",
          "content_type": "application/json; charset=utf-8",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "mail@example.com'); SELECT 1; --"
            }
          ],
          "description": "Statement break attempt (should be handled safely by ORM)",
          "encoding": "json",
          "content_type": "application/json; charset=utf-8",
          "header": []
        }
      ],
      "prerequisites": [
        {
          "type": "csrf_token",
          "description": "Obtain CSRF token value from prior GET form/source",
          "extract_from": "prior_response",
          "bind_to": "csrf"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "compare_to_baseline",
          "threshold": {
            "expected_codes": [
              200,
              201,
              202,
              400,
              422,
              500
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "delta_vs_baseline",
          "threshold": {
            "body_length_delta_pct": 30.0
          },
          "weight": 1.0
        },
        {
          "signal": "error_signature",
          "condition": "contains_db_error",
          "threshold": {
            "string_value": "SQL|mysql|postgres|sqlite|odbc|oracle|syntax error"
          },
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 4
      },
      "max_retries": 1,
      "delay_between_requests": 0.3,
      "notes": "Run after PLAN-2 using same CSRF/token/session context. Abort remaining subscribe probes if server strictly rejects malformed inputs with consistent 422.",
      "tags": [
        "injection_sql",
        "subscribe",
        "stateful_flow"
      ]
    },
