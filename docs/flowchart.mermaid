---
config:
  theme: base
  themeVariables:
    primaryColor: '#fff'
    primaryTextColor: '#000'
    primaryBorderColor: '#000'
    lineColor: '#000'
---
flowchart TD
    %% ---------- Inisialisasi ----------
    A([Start • Input Target])
    B[Collect Baseline]
    A --> B

    %% ---------- Antrian Test Case ----------
    B --> C{{Process Test Case}}

    C --> D[Run Heuristic Checks]
    D --> E[Compute score s]

    %% ---------- Zona Rendah ----------
    E -->|s &lt; T_low| X[Discard & Next]

    %% ---------- Zona Tinggi ----------
    E -->|s &gt; T_high| H[Light PoC Validation]
    H -->|PoC positif| L[High Confidence → Exploitation]
    H -->|PoC gagal| G[Send to LLM]

    %% ---------- Zona Ambigu ----------
    E -->|T_low ≤ s ≤ T_high| G

    %% ---------- Jalur LLM ----------
    subgraph LLM_Path
        G --> I[LLM Analysis payload + endpoint]
        I --> J{{LLM verdict}}
    end

    %% ---------- Konsensus ----------
    H -. "PoC gagal" .-> J
    J --> K{{Consensus Validator}}

    K -->|Tinggi| L
    K -->|Rendah| N[Ignore / Log]

    %% ---------- Iterasi Otomatis ----------
    K -->|Menengah| D0{{depth &lt; 3?}}
    D0 -->|Yes| C
    D0 -->|No| N

    %% ---------- Reporting ----------
    L --> R[Append to Report]
    N --> P[Log]

    %% ---------- Penanda loop ----------
    C -->|next item in queue| C