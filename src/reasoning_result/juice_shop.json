{
  "test_cases": [
    {
      "id": "tc-hv05-rest_user_login_token_leak",
      "hypothesis_id": "hv05-rest_user_login_token_leak",
      "base_url": "http://localhost:3000",
      "method": "POST",
      "endpoint": "/rest/user/login",
      "parameter": "email,password",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "body",
              "value": "ggggg@mail.com"
            },
            {
              "location": "body",
              "value": "ggggg"
            }
          ],
          "description": "Baseline login with observed valid credentials",
          "content_type": "application/json"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "ggggg@mail.com"
            },
            {
              "location": "body",
              "value": "wrongpass"
            }
          ],
          "description": "Probe with incorrect password to compare responses",
          "content_type": "application/json"
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "sensitive_data_exposed",
          "condition": "response.status_code==200 and (response.json.get('authentication',{}).get('token') is not None or 'token' in response.body)",
          "threshold": {
            "body_length_delta_pct": 5.0,
            "expected_codes": [
              200
            ]
          },
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 30
      },
      "max_retries": 1,
      "delay_between_requests": 1.0,
      "notes": "Authenticate once and use obtained auth cookie/token for subsequent chained tests. Do not persist tokens outside test harness. Respect rate limits.",
      "tags": [
        "auth",
        "token_leak"
      ],
      "estimated_duration": 60
    },
