{
  "test_cases": [
    {
      "id": "exec-1-auth",
      "hypothesis_id": "hypo-015",
      "base_url": "http://localhost:3000",
      "method": "POST",
      "endpoint": "/rest/user/login",
      "parameter": "email",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "body",
              "value": "{\"email\":\"user@example.com\",\"password\":\"correcthorsebatterystaple\"}"
            }
          ],
          "description": "Establish valid session/token baseline",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "{\"email\":\"user@example.com\",\"password\":\"wrongpass\"}"
            }
          ],
          "description": "Single invalid attempt to observe status/timing",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "body",
              "value": "{\"email\":\"user@example.com\",\"password\":\"password1\"}"
            }
          ],
          "description": "Additional safe attempts to detect lockout/rate-limit behavior",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": []
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "response.status_code in [200,401,429] across attempts",
          "threshold": {
            "expected_codes": [
              200,
              401,
              429
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "timing_anomaly",
          "condition": "response.time_ms > baseline.time_ms + 2000",
          "threshold": {
            "timing_ms": 2000
          },
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 50
      },
      "max_retries": 2,
      "delay_between_requests": 2.0,
      "notes": "Run first to obtain auth token if successful; stop if 429 returned",
      "tags": [
        "auth",
        "bruteforce"
      ],
      "estimated_duration": 10
    },
