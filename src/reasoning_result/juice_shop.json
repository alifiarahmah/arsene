            {
              "location": "body",
              "value": "{\"email\":\"testuser@example.com\",\"password\":\"wrongpass1\"}"
            }
          ],
          "description": "Small number of incorrect attempts to detect rate limiting or lockout",
          "encoding": "utf-8",
          "content_type": "application/json"
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "body",
              "value": "{\"email\":\"testuser@example.com\",\"password\":\"wrongpass2\"}"
            }
          ],
          "description": "Additional incorrect attempts within max_requests to trigger rate limit signals",
          "encoding": "utf-8",
          "content_type": "application/json"
        }
      ],
      "prerequisites": [
        {
          "type": "custom",
          "description": "Use non-privileged test account; no auth required"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "response.status_code in [200,401,429] and response.status_code != baseline.status_code",
          "threshold": {
            "expected_codes": [
              200,
              401,
              429
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "timing_anomaly",
          "condition": "response.time_ms > baseline.time_ms + 2000",
          "threshold": {
            "timing_ms": 2000
          },
          "weight": 0.6
        }
