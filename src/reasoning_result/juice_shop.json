    {
      "id": "TC-CHAIN-007",
      "hypothesis_id": "VH-005",
      "base_url": "http://localhost:3000",
      "method": "GET",
      "endpoint": "/rest/products/search",
      "parameter": "",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query",
              "value": "q=apple"
            }
          ],
          "description": "Baseline search query q=apple",
          "content_type": "application/json"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "q=<script>alert(1)</script>"
            }
          ],
          "description": "Probe for reflected input in search results using non-executing payload",
          "content_type": "application/json"
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "query",
              "value": "q=%3Cimg%20src%3Dx%20onerror%3D%22console.log(1)%22%3E"
            }
          ],
          "description": "Probe for HTML injection reflected in JSON/HTML (non-executing)",
          "content_type": "application/json"
        }
      ],
      "prerequisites": [
        {
          "type": "login",
          "description": "Optional authenticated session may change results; run after initial info-gathering",
          "bind_to": "session_cookie_or_token"
        }
      ],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "payload_value in response.body",
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "abs(len(response.body)-len(baseline.body))/max(1,len(baseline.body)) > 0.30",
          "threshold": {
            "body_length_delta_pct": 30.0
          },
          "weight": 0.8
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 100
      },
      "max_retries": 3,
      "delay_between_requests": 0.5,
      "notes": "Use non-executing payloads to detect reflection. Do not store malicious payloads.",
      "tags": [
        "xss",
        "injection"
      ],
      "estimated_duration": 5
    },
