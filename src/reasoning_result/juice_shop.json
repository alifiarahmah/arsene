{
  "test_cases": [
    {
      "id": "TC-LOGIN-BRUTEFORCE-THROTTLE-001",
      "hypothesis_id": "POST /rest/user/login - login CSRF or brute-force",
      "base_url": "http://localhost:3000",
      "method": "POST",
      "endpoint": "/rest/user/login",
      "parameter": "password",
      "param_location": "body",
      "payloads": [
        {
          "tier": "benign",
          "value": "{\"email\":\"tester@example.com\",\"password\":\"CorrectHorseBatteryStaple1!\"}",
          "description": "Baseline valid login attempt",
          "encoding": "utf-8",
          "content_type": "application/json"
        },
        {
          "tier": "probe",
          "value": "{\"email\":\"tester@example.com\",\"password\":\"incorrect-pass-{{RAND}}\"}",
          "description": "Multiple safe invalid attempts to detect rate limits or throttling",
          "encoding": "utf-8",
          "content_type": "application/json"
        }
      ],
      "prerequisites": [
        {
          "type": "custom",
          "description": "No auth required for initial login; capture CSRF token if present on login form",
          "custom_logic": "Parse login page for CSRF hidden field or JS token and include in payload if found"
        }
      ],
      "oracle_rules": [
        {
          "signal": "timing_anomaly",
          "condition": "Observe response time increases > baseline + 3000ms indicating throttling",
          "threshold": {
            "timing_ms": 3000
          },
          "weight": 0.8
        },
        {
          "signal": "status_code_change",
          "condition": "Different status codes (200 vs 401 vs 429) observed between valid, invalid and blocked attempts",
          "threshold": {
            "expected_codes": [
              200,
              401,
              429
            ]
          },
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 100
      },
      "max_retries": 3,
      "delay_between_requests": 2.0,
      "notes": "Start with single benign login to establish session. Perform low-frequency invalid attempts and monitor for 429/long response times. Stop if IP blocked.",
      "tags": [
        "auth",
        "bruteforce",
        "throttle"
      ],
      "estimated_duration": 600
    },
