      "base_url": "http://localhost:3000",
      "method": "POST",
      "endpoint": "/rest/user/login",
      "parameter": "email,password",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "body",
              "value": "{\"email\":\"user@example.com\",\"password\":\"CorrectHorseBatteryStaple\",\"token\":\"csrf-placeholder\"}"
            }
          ],
          "description": "Login baseline including CSRF token if available",
          "encoding": "utf-8",
          "content_type": "application/x-www-form-urlencoded"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "{\"email\":\"user@example.com\",\"password\":\"CorrectHorseBatteryStaple\"}"
            }
          ],
          "description": "Submit login without CSRF token to test server enforcement",
          "encoding": "utf-8",
          "content_type": "application/x-www-form-urlencoded"
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "body",
              "value": "{\"email\":\"user@example.com\",\"password\":\"CorrectHorseBatteryStaple\",\"token\":\"\"}"
            }
          ],
          "description": "Explicitly blank token to test weak validation",
          "encoding": "utf-8",
          "content_type": "application/x-www-form-urlencoded"
        }
      ],
      "prerequisites": [
        {
          "type": "csrf_token",
          "description": "server expects token_in_form; capture token from login page form",
          "extract_from": "/rest/user/login (GET)",
          "bind_to": "token"
        },
        {
          "type": "session_state",
          "description": "anonymous session allowed; ensure session cookie present"
        }
      ],
      "oracle_rules": [
        {
          "signal": "header_change",
          "condition": "login_accepted_when_token_missing (compare baseline.headers to probe.headers)",
          "weight": 1.0
        },
        {
          "signal": "status_code_change",
          "condition": "response.status_code in [200] and baseline.status_code in [200]",
          "threshold": {
            "expected_codes": [
              200,
              403
            ]
          },
          "weight": 0.9
        }
      ],
      "pass_logic": "all",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 10
      },
      "max_retries": 1,
      "delay_between_requests": 1.0,
      "notes": "Fetch login page to extract CSRF token before baseline. Do not perform credential stuffing; use single known test account.",
      "tags": [
        "csrf",
        "auth"
      ],
      "estimated_duration": 8
    },
