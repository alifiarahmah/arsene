          "description": "Use Authorization header from previous steps"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "compare status codes across ids and endpoints; flag 200 for unexpected ids or ACL differences",
          "threshold": {
            "expected_codes": [
              200,
              403,
              404,
              401
            ]
          },
          "weight": 1.0
