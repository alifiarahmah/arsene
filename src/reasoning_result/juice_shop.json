{
  "test_cases": [
    {
      "id": "TC-CHAIN-001",
      "hypothesis_id": "VH-023",
      "base_url": "http://localhost:3000",
      "method": "POST",
      "endpoint": "/rest/user/login",
      "parameter": "email,password,authentication",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "body",
              "value": "email=user@example.com&password=correcthorsebatterystaple"
            }
          ],
          "description": "Baseline legitimate login to establish session",
          "encoding": "application/x-www-form-urlencoded",
          "content_type": "application/x-www-form-urlencoded"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "email=user@example.com&password=wrongpassword"
            }
          ],
          "description": "Probe failed login to observe status and timing differences",
          "encoding": "application/x-www-form-urlencoded",
          "content_type": "application/x-www-form-urlencoded"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "email=user@example.com&password=attempt2"
            }
          ],
          "description": "Additional safe probes to detect rate limiting/timing anomalies",
          "encoding": "application/x-www-form-urlencoded",
          "content_type": "application/x-www-form-urlencoded"
        }
      ],
      "prerequisites": [
        {
          "type": "csrf_token",
          "description": "CSRF token required for login form; extract from GET /rest/user/login or page",
          "extract_from": "/rest/user/login GET response",
          "bind_to": "csrf_token"
        }
      ],
      "oracle_rules": [
        {
          "signal": "timing_anomaly",
          "condition": "response.time_ms > baseline.time_ms + 2000",
          "threshold": {
            "timing_ms": 2000
          },
          "weight": 1.0
        },
        {
          "signal": "status_code_change",
          "condition": "response.status_code in [200,401,429]",
          "threshold": {
            "expected_codes": [
              200,
              401,
              429
            ]
          },
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 100
      },
      "max_retries": 5,
      "delay_between_requests": 5.0,
      "notes": "Authenticate first; respect rate limits and delays to avoid lockouts.",
      "tags": [
        "chained",
        "auth"
      ],
      "estimated_duration": 30
    },
