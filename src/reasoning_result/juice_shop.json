        {
          "signal": "sensitive_data_exposed",
          "condition": "response.body contains keys indicative of basket ownership such as [\"orderId\",\"paymentId\",\"addressId\"]",
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 50
      },
      "max_retries": 3,
      "delay_between_requests": 0.5,
      "notes": "Chain after authentication. Compare against baseline to detect authz issues.",
      "tags": [
        "idor",
        "authz"
      ],
      "estimated_duration": 3
    },
