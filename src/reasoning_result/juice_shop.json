        {
          "type": "login",
          "description": "Use token from exec-1 if available; otherwise run exec-1 first",
          "extract_from": "previous_step",
          "bind_to": "Authorization"
        }
      ],
      "oracle_rules": [
        {
          "signal": "sensitive_data_exposed",
          "condition": "response.body contains \"email\" or response.body contains \"id\"",
          "weight": 1.0
        },
        {
          "signal": "status_code_change",
          "condition": "response.status_code in [200,401] (compare authorized vs no-auth)",
          "threshold": {
            "expected_codes": [
              200,
              401
            ]
          },
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 10
      },
      "max_retries": 2,
      "delay_between_requests": 0.5,
      "notes": "Run after auth to compare authorized vs missing/invalid token",
      "tags": [
        "info_disclosure",
        "auth_bypass"
      ],
      "estimated_duration": 2
    },
