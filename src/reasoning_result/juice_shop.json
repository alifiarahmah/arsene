{
  "test_cases": [
    {
      "id": "auth_flow_login",
      "hypothesis_id": "POST_/rest/user/login_csrf_token_required_detection",
      "method": "POST",
      "endpoint": "/rest/user/login",
      "parameter": "email",
      "param_location": "body",
      "payloads": [
        {
          "tier": "benign",
          "value": "email=user%40example.com&password=badpass&csrf-token={{login_csrf}}",
          "description": "Baseline login with valid CSRF token extracted from login form",
          "encoding": "application/x-www-form-urlencoded",
          "content_type": "application/x-www-form-urlencoded"
        },
        {
          "tier": "probe",
          "value": "email=user%40example.com&password=badpass",
          "description": "Probe login without CSRF token to detect CSRF enforcement",
          "encoding": "application/x-www-form-urlencoded",
          "content_type": "application/x-www-form-urlencoded"
        }
      ],
      "prerequisites": [
        {
          "type": "csrf_token",
          "description": "Extract CSRF token from login page form and bind to login_csrf",
          "extract_from": "/rest/user/login GET response form",
          "bind_to": "login_csrf"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "probe.response.status_code != baseline.response.status_code",
          "threshold": {
            "expected_codes": [
              200,
              401,
              403
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "reflected_input",
          "condition": "baseline.response.body contains email OR probe.response.body contains email",
          "threshold": {
            "body_length_delta_pct": 10.0
          },
          "weight": 0.5
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 20
      },
      "max_retries": 1,
      "delay_between_requests": 1.0,
      "notes": "Establish session first. Do not perform credential stuffing; use dummy credentials.",
      "tags": [
        "authentication",
        "csrf"
      ],
      "estimated_duration": 30
    },
