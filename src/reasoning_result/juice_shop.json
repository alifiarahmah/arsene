        },
        {
          "signal": "response_length_diff",
          "condition": "abs(len(response.body)-len(baseline.body))/max(1,len(baseline.body)) > 0.50",
          "threshold": {
            "body_length_delta_pct": 50.0
          },
          "weight": 0.8
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 20
      },
      "max_retries": 1,
      "delay_between_requests": 2.0,
      "notes": "Captcha present; avoid automated bypass attempts. Limit submissions and ensure CSRF token present.",
      "tags": [
        "captcha",
        "automation"
      ],
      "estimated_duration": 10
