    {
      "id": "TC-HV-GET-/rest/user/whoami-account-disclosure",
      "hypothesis_id": "HV-GET-/rest/user/whoami-account-disclosure",
      "base_url": "http://localhost:3000",
      "method": "GET",
      "endpoint": "/rest/user/whoami",
      "parameter": "user",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query",
              "value": "?user=self"
            }
          ],
          "description": "Baseline whoami request as authenticated user",
          "content_type": "application/json"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "?user=other"
            }
          ],
          "description": "Probe whether query parameter exposes other account information",
          "content_type": "application/json"
        }
      ],
      "prerequisites": [
        {
          "type": "login",
          "description": "authenticated session required"
        }
      ],
      "oracle_rules": [
        {
          "signal": "sensitive_data_exposed",
          "condition": "response.body contains PII fields like 'email' or 'lastLoginIp' beyond baseline",
          "weight": 1.0
        },
        {
          "signal": "reflected_input",
          "condition": "payload_value in response.body",
          "weight": 0.6
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 5
      },
      "max_retries": 1,
      "delay_between_requests": 1.0,
      "notes": "Do not attempt to enumerate many users; limit to few checks.",
      "tags": [
        "whoami",
        "pii"
      ],
      "estimated_duration": 6
    },
    {
      "id": "TC-HV-GET-/rest/admin/application-configuration-privilege-escalation",
      "hypothesis_id": "HV-GET-/rest/admin/application-configuration-privilege-escalation",
      "base_url": "http://localhost:3000",
      "method": "GET",
      "endpoint": "/rest/admin/application-configuration",
      "parameter": "name",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query",
              "value": "?name=baseline"
            }
          ],
          "description": "Baseline GET as non-admin to capture response",
          "content_type": "application/json"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "?name=config"
            }
          ],
          "description": "Request admin config as non-admin to detect privilege escalation",
          "content_type": "application/json"
        }
      ],
      "prerequisites": [
        {
          "type": "login",
          "description": "test with non-admin authenticated session; also compare to admin session"
        }
      ],
      "oracle_rules": [
        {
          "signal": "sensitive_data_exposed",
          "condition": "response.body contains keys like 'config' or 'domain' not present in baseline for non-admin",
          "weight": 1.0
        },
        {
          "signal": "status_code_change",
          "condition": "response.status_code == 200 and baseline.status_code != 200",
          "threshold": {
            "expected_codes": [
              200,
              403,
              401
            ]
          },
          "weight": 0.8
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 10
      },
      "max_retries": 2,
      "delay_between_requests": 1.0,
      "notes": "Compare non-admin vs admin responses. Limit requests and avoid exposing admin credentials.",
      "tags": [
        "privilege-escalation",
        "admin"
      ],
      "estimated_duration": 12
    },
