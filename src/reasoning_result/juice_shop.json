            }
          ],
          "description": "Baseline valid feedback submission with valid captcha and CSRF token",
          "encoding": "utf-8",
          "content_type": "application/json"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "{\"captcha\":\"wrong\",\"captchaId\":\"<validId>\",\"comment\":\"probe\",\"rating\":1}"
            }
          ],
          "description": "Probe with invalid captcha to observe rejection response",
          "encoding": "utf-8",
          "content_type": "application/json"
        }
      ],
      "prerequisites": [
        {
          "type": "csrf_token",
          "description": "CSRF token required in form/body; extract from GET form or page",
          "extract_from": "/api/Feedbacks/ page or related form",
          "bind_to": "csrf_token",
          "custom_logic": "attach token as header or body field as observed"
        },
        {
          "type": "login",
          "description": "If submission requires session, use authenticated session from TC-CHAIN-001",
          "bind_to": "session_cookie_or_token"
        }
      ],
      "oracle_rules": [
        {
          "signal": "authentication_bypassed",
          "condition": "response.status_code in [200,201] and response.body contains success indication while probe baseline with invalid captcha returns 4xx",
