    {
      "id": "exec-1-auth-gather",
      "hypothesis_id": "h1,h3,h8",
      "base_url": "http://localhost",
      "method": "GET",
      "endpoint": "/rest/user/whoami",
      "parameter": "profileImage",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "body",
              "value": "{\"profileImage\":\"/assets/public/images/uploads/default.svg\"}"
            }
          ],
          "description": "Initial authenticated identity check to establish valid JWT behavior and baseline response",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": [
            {
              "header_name": "Authorization",
              "header_value": "Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..NvVTXZsk8zrJqC1BIESlmzmMwy3o646U8KHx0Y8bu1Vf-tqIp5oii9hatVub2JERDq9OYCEHaM8wPJBlZvAI8QLm3GUBgWITFO7d_sCWHEuvAY1XMZYcDxgtoP08Wxv0H9_NZVGBQ7wMddu0tWLMwPjhxmtO4MoypcLEhMoNxOg"
            },
            {
              "header_name": "Content-Type",
              "header_value": "application/json"
            }
          ]
        }
      ],
      "prerequisites": [
        {
          "type": "jwt_refresh",
          "description": "Use observed JWT for authenticated requests; include in Authorization header as Bearer token",
          "bind_to": "Authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..NvVTXZsk8zrJqC1BIESlmzmMwy3o646U8KHx0Y8bu1Vf-tqIp5oii9hatVub2JERDq9OYCEHaM8wPJBlZvAI8QLm3GUBgWITFO7d_sCWHEuvAY1XMZYcDxgtoP08Wxv0H9_NZVGBQ7wMddu0tWLMwPjhxmtO4MoypcLEhMoNxOg"
        }
      ],
      "oracle_rules": [
        {
          "signal": "sensitive_data_exposed",
          "condition": "capture and log JWT-validated whoami response and extract claims for later use",
          "weight": 1.0
        }
      ],
      "pass_logic": "all",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 3
      },
      "max_retries": 1,
      "delay_between_requests": 0.5,
      "notes": "First step: confirm authentication, collect baseline for auth-dependent endpoints and verify token works across services",
      "tags": [
        "auth",
        "gather"
      ],
      "estimated_duration": 30
    },
    {
