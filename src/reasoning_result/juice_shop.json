    {
      "id": "TC-CHAIN-003",
      "hypothesis_id": "VH-002",
      "base_url": "http://localhost:3000",
      "method": "GET",
      "endpoint": "/rest/basket/{basketId}",
      "parameter": "basketId",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "path",
              "value": "6"
            }
          ],
          "description": "Baseline request to own basketId=6",
          "content_type": "application/json"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "path",
              "value": "7"
            }
          ],
          "description": "Probe nearby id to detect possible IDOR",
          "content_type": "application/json"
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "path",
              "value": "1"
            }
          ],
          "description": "Probe other observed id to check authorization enforcement",
          "content_type": "application/json"
        }
