    {
      "id": "TC-H5-GET-/-cookie-connect.sid-auth-bypass",
      "hypothesis_id": "H5-GET-/-cookie-connect.sid-auth-bypass-session-fixation",
      "base_url": "https://brokencrystals.com",
      "method": "GET",
      "endpoint": "/",
      "parameter": "connect.sid",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "cookie",
              "value": ""
            }
          ],
          "description": "Baseline using current valid session cookie"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "cookie",
              "value": "replace_with_invalid_session_token"
            }
          ],
          "description": "Probe by replaying an invalid or altered cookie to observe authentication handling"
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "cookie",
              "value": "replay_observed_cookie_value"
            }
          ],
          "description": "Replay of observed valid session cookie to test session fixation/replay handling"
        }
      ],
      "prerequisites": [
        {
          "type": "login",
          "description": "Have a valid authenticated session cookie (connect.sid) available for baseline and replay tests"
        }
      ],
      "oracle_rules": [
        {
          "signal": "authentication_bypassed",
          "condition": "response.status_code == 200 and resource_accessible_without_expected_privileges",
          "weight": 1.0
        },
        {
          "signal": "status_code_change",
          "condition": "response.status_code not in baseline.status_code",
          "threshold": {
            "expected_codes": [
              200,
              401,
              403
            ]
          },
          "weight": 0.7
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 20
      },
      "max_retries": 1,
      "delay_between_requests": 1.0,
      "notes": "Do not brute-force session tokens. Use single replay and one invalid test. Respect rate limits.",
      "tags": [
        "auth",
        "session",
        "cookie"
      ],
      "estimated_duration": 30
    }
