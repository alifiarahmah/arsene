{
  "test_cases": [
    {
      "id": "TC-H005-POST-/catalog/subscribe-email",
      "hypothesis_id": "H005",
      "base_url": "https://ginandjuice.shop",
      "method": "POST",
      "endpoint": "/catalog/subscribe",
      "parameter": "email",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "body",
              "value": "{\"email\":\"tester@example.com\",\"csrf\":\"{{csrf_token}}\",\"coupon\":\"\"}"
            }
          ],
          "description": "Baseline legitimate subscribe with valid CSRF token",
          "encoding": "utf-8",
          "content_type": "application/json;charset=UTF-8",
          "header": [
            {
              "header_name": "referer",
              "header_value": "https://ginandjuice.shop/"
            }
          ]
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "{\"email\":\"attacker@example.com\",\"csrf\":\"invalid-token\",\"coupon\":\"\"}"
            }
          ],
          "description": "Probe with invalid CSRF token to observe status/response changes",
          "encoding": "utf-8",
          "content_type": "application/json;charset=UTF-8",
          "header": [
            {
              "header_name": "referer",
              "header_value": "https://ginandjuice.shop/"
            }
          ]
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "body",
              "value": "{\"email\":\"victim+injected@example.com\",\"csrf\":\"\",\"coupon\":\"\"}"
            }
          ],
          "description": "Missing CSRF token to test enforcement (non-destructive)",
          "encoding": "utf-8",
          "content_type": "application/json;charset=UTF-8",
          "header": [
            {
              "header_name": "referer",
              "header_value": "https://ginandjuice.shop/"
            }
          ]
        }
      ],
      "prerequisites": [
        {
          "type": "csrf_token",
          "description": "Obtain valid csrf token from page or cookie and bind to {{csrf_token}}",
          "extract_from": "https://ginandjuice.shop/catalog/subscribe or originating page",
          "bind_to": "csrf_token"
        },
        {
          "type": "session_state",
          "description": "Authenticated session cookie if subscribe requires login",
          "bind_to": "cookie_jar"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "response.status_code != baseline.status_code",
          "threshold": {
            "expected_codes": [
              200,
              403,
              401
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "abs(len(response.body) - len(baseline.body)) / max(1,len(baseline.body)) > 0.30",
          "threshold": {
            "body_length_delta_pct": 30.0
          },
          "weight": 0.8
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 10
      },
      "max_retries": 1,
      "delay_between_requests": 1.0,
      "notes": "Bind valid CSRF token before baseline. Do not perform exploit tier repeatedly to avoid creating accounts or subscriptions. Maintain session cookie from global_prerequisites.",
      "tags": [
        "csrf_missing_or_weak"
      ],
      "estimated_duration": 120
    },
