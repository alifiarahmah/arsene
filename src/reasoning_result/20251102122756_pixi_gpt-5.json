    {
      "id": "PLAN-3-ENUM-GET-/pictures/-/user_*-/all_users-ACCEPT",
      "hypothesis_id": "H-ENUM2",
      "base_url": "",
      "method": "GET",
      "endpoint": "/pictures/",
      "parameter": "header:accept",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "header:accept",
              "value": "application/json, text/plain, */*"
            }
          ],
          "description": "Baseline Accept for data listing endpoints",
          "header": [
            {
              "header_name": "referer",
              "header_value": "\"Chromium\";v=\"140\", \"Not=A?Brand\";v=\"24\", \"Google Chrome\";v=\"140\""
            },
            {
              "header_name": "user-agent",
              "header_value": "http://localhost:8000/"
            }
          ]
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "header:accept",
              "value": "application/json"
            }
          ],
          "description": "Prefer JSON for deterministic diffs",
          "header": [
            {
              "header_name": "referer",
              "header_value": "\"Chromium\";v=\"140\", \"Not=A?Brand\";v=\"24\", \"Google Chrome\";v=\"140\""
            },
            {
              "header_name": "user-agent",
              "header_value": "http://localhost:8000/"
            }
          ]
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "header:accept",
              "value": "*/*;q=1,text/html;q=0"
            }
          ],
          "description": "Force non-HTML response to maximize fields",
          "header": [
            {
              "header_name": "referer",
              "header_value": "\"Chromium\";v=\"140\", \"Not=A?Brand\";v=\"24\", \"Google Chrome\";v=\"140\""
            },
            {
              "header_name": "user-agent",
              "header_value": "http://localhost:8000/"
            }
          ]
        }
      ],
      "prerequisites": [
        {
          "type": "session_state",
          "description": "Run unauthenticated to detect exposure without login",
          "custom_logic": "no cookies sent"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "compare codes across Accept variants and endpoints",
          "threshold": {
            "expected_codes": [
              200,
              206,
              401,
              403,
              406,
              404,
              500
            ]
          },
          "weight": 0.5
        },
        {
          "signal": "response_length_diff",
          "condition": "delta >= 25% indicates data leakage",
          "threshold": {
            "body_length_delta_pct": 25.0
          },
          "weight": 0.5
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 9
      },
      "max_retries": 1,
      "delay_between_requests": 0.25,
      "notes": "Apply this case sequentially to /pictures/, /user_pictures/, /user_loves/, /user_likes/, /user_info/, /total_money/, /all_users/ with same payload set to minimize redundancy.",
      "tags": [
        "sensitive_data_exposure",
        "pii",
        "financial",
        "directory-listing"
      ],
      "estimated_duration": 3
    },
    {
      "id": "PLAN-4-AUTH-POST-/upload_photo/-content-type",
