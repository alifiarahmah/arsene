{
  "test_cases": [
    {
      "id": "PLAN-1-AUTH-GET-/login-user",
      "hypothesis_id": "H1",
      "base_url": "",
      "method": "GET",
      "endpoint": "/login",
      "parameter": "query:user",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query:user",
              "value": "mail@example.com"
            }
          ],
          "description": "Baseline valid-looking user value",
          "header": [
            {
              "header_name": "upgrade-insecure-requests",
              "header_value": "1"
            },
            {
              "header_name": "user-agent",
              "header_value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36"
            },
            {
              "header_name": "sec-ch-ua",
              "header_value": "\"Chromium\";v=\"140\", \"Not=A?Brand\";v=\"24\", \"Google Chrome\";v=\"140\""
            },
            {
              "header_name": "content-type",
              "header_value": "application/x-www-form-urlencoded"
            },
            {
              "header_name": "origin",
              "header_value": "http://localhost:8000"
            },
            {
              "header_name": "referer",
              "header_value": "http://localhost:8000/"
            }
          ]
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query:user",
              "value": "../../../../../etc/passwd"
            }
          ],
          "description": "Traversal-ish probe to test auth handling quirks",
          "header": [
            {
              "header_name": "upgrade-insecure-requests",
              "header_value": "1"
            },
            {
              "header_name": "user-agent",
              "header_value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36"
            },
            {
              "header_name": "sec-ch-ua",
              "header_value": "\"Chromium\";v=\"140\", \"Not=A?Brand\";v=\"24\", \"Google Chrome\";v=\"140\""
            },
            {
              "header_name": "content-type",
              "header_value": "application/x-www-form-urlencoded"
            },
            {
              "header_name": "origin",
              "header_value": "http://localhost:8000"
            },
            {
              "header_name": "referer",
              "header_value": "http://localhost:8000/"
            }
          ]
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "query:user",
              "value": "%00admin"
            }
          ],
          "description": "Null byte attempt to bypass comparison logic",
          "header": [
            {
              "header_name": "upgrade-insecure-requests",
              "header_value": "1"
            },
            {
              "header_name": "user-agent",
              "header_value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36"
            },
            {
              "header_name": "sec-ch-ua",
              "header_value": "\"Chromium\";v=\"140\", \"Not=A?Brand\";v=\"24\", \"Google Chrome\";v=\"140\""
            },
            {
              "header_name": "content-type",
              "header_value": "application/x-www-form-urlencoded"
            },
            {
              "header_name": "origin",
              "header_value": "http://localhost:8000"
            },
            {
              "header_name": "referer",
              "header_value": "http://localhost:8000/"
            }
          ]
        }
      ],
      "prerequisites": [
        {
          "type": "session_state",
          "description": "Ensure no authenticated session cookies are sent to observe true unauthenticated behavior",
          "custom_logic": "clear cookies for domain before requests"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "compare each probe/exploit response code vs benign baseline",
          "threshold": {
            "expected_codes": [
              200,
              302,
              303,
              307,
              401,
              403,
              404,
              500,
              503,
              301,
              308,
              400,
              422,
              429
            ]
          },
          "weight": 0.5
        },
        {
          "signal": "response_length_diff",
          "condition": "absolute(body_length_delta_pct) >= threshold compared to benign",
          "threshold": {
            "body_length_delta_pct": 30.0
          },
          "weight": 0.3
        },
        {
          "signal": "error_signature",
          "condition": "response body contains common error markers",
          "threshold": {
            "string_value": "Exception|Traceback|stack trace|ValueError|TypeError|KeyError|NullReference|SQLSTATE|PDOException"
          },
          "weight": 0.2
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 5
      },
      "max_retries": 1,
      "delay_between_requests": 0.3,
      "notes": "Stop further unauth enum if this redirects to authenticated area without creds (potential authn weakness).",
      "tags": [
        "authn_bypass",
        "content-negotiation",
        "unauthenticated"
      ],
      "estimated_duration": 1
    },
