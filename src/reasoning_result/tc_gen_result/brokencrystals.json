    {
      "id": "TC-H3-query-meta-injection-theme-color",
      "hypothesis_id": "H3-query-meta-injection-theme-color",
      "base_url": "https://brokencrystals.com",
      "method": "GET",
      "endpoint": "/",
      "parameter": "theme-color",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query",
              "value": "#ffffff"
            }
          ],
          "description": "Baseline to observe meta tag and header behavior"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "#\"><meta name=x content=y>"
            }
          ],
          "description": "Probe to detect injection into meta tags or header-like contexts",
          "content_type": "application/x-www-form-urlencoded"
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "query",
              "value": "#\"><meta http-equiv=refresh content='0;url=about:blank'>"
            }
          ],
          "description": "Exploit-like payload to detect meta tag injection impacts (non-destructive)",
          "content_type": "application/x-www-form-urlencoded"
        },
        {
          "tier": "destructive",
          "payloads": [
            {
              "location": "query",
              "value": ""
            }
          ],
          "description": "Destructive payloads not allowed per safety"
        }
      ],
      "prerequisites": [
        {
          "type": "session_state",
          "description": "Use observed session cookie if available",
          "bind_to": "connect.sid"
        },
        {
          "type": "custom",
          "description": "Capture baseline response headers and HTML head section"
        }
      ],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "payload_value in response.body or payload_value in response.headers.get('Content-Security-Policy','')",
          "threshold": {
            "body_length_delta_pct": 20.0,
            "expected_codes": [
              200
            ]
          },
          "weight": 0.9
        },
        {
          "signal": "header_change",
          "condition": "response.headers != baseline.headers",
          "threshold": {
            "expected_codes": [
              200
            ]
          },
          "weight": 0.6
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 30
      },
      "max_retries": 2,
      "delay_between_requests": 1.5,
      "notes": "Focus on head/meta reflections. Respect max_requests and idempotency. Rate-limit probes.",
      "tags": [
        "meta-injection",
        "query",
        "headers"
      ],
      "estimated_duration": 180
    },
