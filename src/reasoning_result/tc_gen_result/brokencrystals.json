{
  "test_cases": [
    {
      "id": "tc-hyp-1",
      "hypothesis_id": "hyp-1",
      "base_url": "https://brokencrystals.com",
      "method": "GET",
      "endpoint": "/",
      "parameter": "config",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query",
              "value": "config=baseline"
            }
          ],
          "description": "Baseline benign request with harmless config value"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "config=<INJECT-REFLECT-TEST-12345>"
            }
          ],
          "description": "Probe for reflection of unique marker in response"
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "query",
              "value": "config=<script>/*xss*/alert(1)</script>"
            }
          ],
          "description": "XSS-style payload to test for HTML/script reflection/execution in controlled environment"
        }
      ],
      "prerequisites": [
        {
          "type": "login",
          "description": "Authenticated session required (connect.sid cookie)"
        }
      ],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "payload_value in response.body",
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "abs(len(response.body) - len(baseline.body)) / len(baseline.body) > 0.20",
          "threshold": {
            "body_length_delta_pct": 20.0
          },
          "weight": 0.8
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 50
      },
      "max_retries": 2,
      "delay_between_requests": 1.5,
      "notes": "Include baseline before probes. Respect max_requests and rate limits. Use authenticated cookie (connect.sid).",
      "tags": [
        "xss",
        "reflected",
        "authenticated"
      ],
      "estimated_duration": 60
    },
