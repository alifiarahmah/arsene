{
  "test_cases": [
    {
      "id": "TC-H1-root-query-reflection",
      "hypothesis_id": "H1-root-query-reflection",
      "method": "GET",
      "endpoint": "/",
      "parameter": "config",
      "param_location": "query",
      "payloads": [
        {
          "tier": "benign",
          "value": "marker=REFLECT_TEST_123",
          "description": "Baseline benign marker to detect reflection",
          "content_type": "application/x-www-form-urlencoded"
        },
        {
          "tier": "probe",
          "value": "%3Cscript%3Econsole.log('X')%3C%2Fscript%3E",
          "description": "Encoded probe payload to detect HTML reflection without executing",
          "encoding": "url",
          "content_type": "application/x-www-form-urlencoded"
        },
        {
          "tier": "exploit",
          "value": "<script>window.__XSS=1</script>",
          "description": "Proof-of-concept XSS payload (only if safety allows execution)",
          "content_type": "application/x-www-form-urlencoded"
        }
      ],
      "prerequisites": [
        {
          "type": "session_state",
          "description": "Valid session cookie observed in HAR (connect.sid) to reproduce same context",
          "extract_from": "cookie: connect.sid",
          "bind_to": "cookie: connect.sid"
        }
      ],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "payload_value in response.body",
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "abs(len(response.body) - len(baseline.body)) / max(1,len(baseline.body)) > 0.10",
          "threshold": {
            "body_length_delta_pct": 10.0
          },
          "weight": 0.5
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 20
      },
      "max_retries": 2,
      "delay_between_requests": 1.5,
      "notes": "Start with benign marker to record baseline. Probe uses encoded script to avoid trivial blocking. Exploit payload present but will not be executed if environment disallows. Respect max_requests and delays to avoid rate limits.",
      "tags": [
        "xss",
        "reflection",
        "baseline"
      ],
      "estimated_duration": 5
    },
