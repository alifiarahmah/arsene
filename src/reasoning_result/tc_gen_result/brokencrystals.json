    {
      "id": "TC-H1-GET-/-config-path-traversal-or-ssrf",
      "hypothesis_id": "H1-GET-/-config-path-traversal-or-ssrf",
      "base_url": "https://brokencrystals.com",
      "method": "GET",
      "endpoint": "/",
      "parameter": "config",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "path",
              "value": "/api/config"
            }
          ],
          "description": "Baseline: fetch observed config path"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "path",
              "value": "/api/config?source=local"
            }
          ],
          "description": "Probe: modify path to include benign query to observe differences"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "path",
              "value": "/api/config/../../etc/passwd"
            }
          ],
          "description": "Probe: path traversal style payload (benign read-only probe)"
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "path",
              "value": "http://example.com/remote-config"
            }
          ],
          "description": "Probe for SSRF: replace with external URL to detect remote fetch (non-destructive)"
        }
      ],
      "prerequisites": [
        {
          "type": "session_state",
          "description": "Authenticated session required; include connect.sid cookie from capture",
          "extract_from": "cookies.connect.sid"
        },
        {
          "type": "custom",
          "description": "Ensure baseline response captured for comparison"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "response.status_code not in baseline.status_codes",
          "threshold": {
            "expected_codes": [
              200,
              400,
              500
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "abs(len(response.body)-len(baseline.body))/max(1,len(baseline.body)) > 0.30",
          "threshold": {
            "body_length_delta_pct": 30.0
          },
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 50
      },
      "max_retries": 1,
      "delay_between_requests": 1.5,
      "notes": "Start with benign baseline; probes are read-only. When testing SSRF external URL, monitor for DNS/HTTP callbacks. Respect max_requests and low request rate.",
      "tags": [
        "ssrf",
        "path_traversal",
        "read_only"
      ],
      "estimated_duration": 5
    },
