      "id": "tc-hv03-api_Feedbacks_captcha_bypass",
      "hypothesis_id": "hv03-api_Feedbacks_captcha_bypass",
      "base_url": "http://localhost:3000",
      "method": "POST",
      "endpoint": "/api/Feedbacks/",
      "parameter": "comment",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "body",
              "value": "kenapa begini? (anonymous)"
            },
            {
              "location": "body",
              "value": "0"
            },
            {
              "location": "body",
              "value": "-7"
            },
            {
              "location": "body",
              "value": "3"
            }
          ],
          "description": "Baseline valid feedback submission using observed captchaId/captcha",
          "content_type": "application/json"
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "probe-comment-<test>"
            }
          ],
          "description": "Submit altered comment with same captcha to test reflection and bypass handling (captcha may block if incorrect)",
          "content_type": "application/json"
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "body",
              "value": "<script>alert(1)</script>"
            }
          ],
          "description": "Attempt to submit XSS payload in comment to see if response reflects or stores it (respect captcha)",
          "content_type": "application/json"
        }
      ],
      "prerequisites": [
        {
          "type": "custom",
          "description": "Obtain valid captchaId and captcha answer via GET /rest/captcha/ and use values in body",
          "extract_from": "/rest/captcha/",
          "bind_to": "captcha,captchaId"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "response.status_code==201",
          "threshold": {
            "expected_codes": [
              201
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "reflected_input",
          "condition": "payload_value in response.body or payload_value in subsequent GET /api/Feedbacks/ entries",
          "threshold": {
            "body_length_delta_pct": 10.0,
            "expected_codes": [
              201
            ]
          },
          "weight": 0.8
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 20
      },
      "max_retries": 1,
      "delay_between_requests": 1.0,
      "notes": "Must solve/obtain captcha. Use benign first. Do not flood endpoints. Store created feedback IDs for cleanup if needed.",
      "tags": [
        "captcha_bypass",
        "xss"
      ],
      "estimated_duration": 120
    },
