{
  "test_cases": [
    {
      "id": "TC_POST_/api/Addresss_/injection_data",
      "hypothesis_id": "POST_/api/Addresss_/insecure_deserialization_or_injection_body_fields",
      "method": "POST",
      "endpoint": "/api/Addresss/",
      "parameter": "data",
      "param_location": "body",
      "payloads": [
        {
          "tier": "benign",
          "value": "{\"data\":\"normal\"}",
          "description": "Baseline benign payload to capture normal response",
          "encoding": "utf-8",
          "content_type": "application/json"
        },
        {
          "tier": "probe",
          "value": "{\"data\":\"INJECT_TEST_123\"}",
          "description": "Probe for reflection and response length change",
          "encoding": "utf-8",
          "content_type": "application/json"
        },
        {
          "tier": "exploit",
          "value": "{\"data\":\"\\\"; throw new Error('exploit'); //\"}",
          "description": "Probe for server error signatures / weak deserialization feedback",
          "encoding": "utf-8",
          "content_type": "application/json"
        }
      ],
      "prerequisites": [
        {
          "type": "login",
          "description": "Authenticated session required (cookie or bearer)"
        },
        {
          "type": "csrf_token",
          "description": "CSRF token requirement unknown; observe and bind if present",
          "bind_to": "csrf-token"
        }
      ],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "probe.value in response.body",
          "threshold": {
            "body_length_delta_pct": 20.0
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "abs(len(response.body) - len(baseline.body))/len(baseline.body) > 0.20",
          "threshold": {
            "body_length_delta_pct": 20.0
          },
          "weight": 1.0
        },
        {
          "signal": "error_signature",
          "condition": "regex_search(response.body, '(Traceback|Exception|SQL|syntax error|stack trace)')",
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 25
      },
      "max_retries": 1,
      "delay_between_requests": 1.0,
      "notes": "Start with benign to record baseline. Respect max_requests. Monitor for CSRF token; bind if observed.",
      "tags": [
        "injection",
        "insecure-deserialization",
        "state-changing"
      ],
      "estimated_duration": 60
    },
