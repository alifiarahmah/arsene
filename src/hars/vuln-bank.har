          "content": {
            "size": 1386,
            "mimeType": "text/html",
            "text": "<!-- HTML for static distribution bundle build -->\n<!DOCTYPE html>\n<html lang=\"en\">\n\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Vulnerable Bank API Documentation</title>\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"/api/docs/index.css\">\n  <link rel=\"stylesheet\" type=\"text/css\" href=\"/api/docs/swagger-ui.css\">\n  <link rel=\"icon\" type=\"image/png\" href=\"/api/docs/favicon-32x32.png\" sizes=\"32x32\" />\n  <link rel=\"icon\" type=\"image/png\" href=\"/api/docs/favicon-16x16.png\" sizes=\"16x16\" />\n</head>\n\n<body>\n  <div id=\"swagger-ui\"></div>\n\n  <script src=\"/api/docs/swagger-ui-bundle.js\"> </script>\n  <script src=\"/api/docs/swagger-ui-standalone-preset.js\"> </script>\n  <script>\n    var config = {\n      presets: [\n        SwaggerUIBundle.presets.apis,\n        SwaggerUIStandalonePreset\n      ],\n      plugins: [\n        SwaggerUIBundle.plugins.DownloadUrl\n      ]\n    };\n    var user_config = {\"dom_id\": \"#swagger-ui\", \"url\": \"/static/openapi.json\", \"layout\": \"StandaloneLayout\", \"deepLinking\": true, \"validatorUrl\": null, \"oauth2RedirectUrl\": \"http://localhost:5000/api/docs/oauth2-redirect.html\"};  // User config options provided from Python code\n    for (var attrname in user_config) { config[attrname] = user_config[attrname]; }\n\n    window.onload = function () {\n      // Build a system\n      const ui = SwaggerUIBundle(config)\n\n      \n\n    window.ui = ui\n}\n  </script>\n</body>\n\n</html>"
