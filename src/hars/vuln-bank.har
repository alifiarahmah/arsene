            "size": 1312,
            "mimeType": "image/svg+xml",
            "text": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\" width=\"32\" height=\"32\">\n  <defs>\n    <linearGradient id=\"bankGradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" style=\"stop-color:#1e40af;stop-opacity:1\" />\n      <stop offset=\"100%\" style=\"stop-color:#3b82f6;stop-opacity:1\" />\n    </linearGradient>\n  </defs>\n  \n  <!-- Bank building base -->\n  <rect x=\"4\" y=\"12\" width=\"24\" height=\"16\" fill=\"url(#bankGradient)\" rx=\"1\"/>\n  \n  <!-- Bank columns -->\n  <rect x=\"7\" y=\"8\" width=\"2\" height=\"16\" fill=\"#f8fafc\"/>\n  <rect x=\"11\" y=\"8\" width=\"2\" height=\"16\" fill=\"#f8fafc\"/>\n  <rect x=\"15\" y=\"8\" width=\"2\" height=\"16\" fill=\"#f8fafc\"/>\n  <rect x=\"19\" y=\"8\" width=\"2\" height=\"16\" fill=\"#f8fafc\"/>\n  <rect x=\"23\" y=\"8\" width=\"2\" height=\"16\" fill=\"#f8fafc\"/>\n  \n  <!-- Bank roof/pediment -->\n  <polygon points=\"2,12 16,4 30,12\" fill=\"#1e3a8a\"/>\n  \n  <!-- Bank entrance -->\n  <rect x=\"13\" y=\"18\" width=\"6\" height=\"6\" fill=\"#1e3a8a\"/>\n  \n  <!-- Dollar sign -->\n  <circle cx=\"16\" cy=\"21\" r=\"2\" fill=\"#fbbf24\"/>\n  <text x=\"16\" y=\"23\" text-anchor=\"middle\" font-family=\"Arial, sans-serif\" font-size=\"2.5\" font-weight=\"bold\" fill=\"#1e3a8a\">$</text>\n  \n  <!-- Bank steps -->\n  <rect x=\"6\" y=\"26\" width=\"20\" height=\"2\" fill=\"#64748b\"/>\n  <rect x=\"8\" y=\"28\" width=\"16\" height=\"1\" fill=\"#475569\"/>\n</svg>"
