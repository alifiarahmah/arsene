          "size" : 2155,
          "compression" : 0,
          "mimeType" : "text/css; charset=UTF-8",
          "text" : "body {\n  background-color: #303030;\n}\n.main-content {\n  display: flex;\n  justify-content: center;\n  margin-bottom: 40px;\n}\n.formBlock {\n  margin-top: 50px;\n  background-color: #424242;\n  width: 600px;\n  height: 400px;\n  border-radius: 0.5rem;\n  padding: 20px;\n  box-shadow: 5px 10px 18px #202020;\n}\nform {\n  margin-top: 10px;\n  display: grid;\n}\nh4,\np,\nh5 {\n  color: whitesmoke;\n}\n.deleteButton{\n  display: flex;\n  justify-content: center;\n  align-items: center;\n}\ninput {\n  border-radius: 0.4rem;\n  width: 100%;\n  padding: 13px 13px 13px 2px;\n  background-color: #424242;\n  border: 1px solid #999898;\n  margin-top: 5px;\n  margin-bottom: 20px;\n  color: whitesmoke;\n}\ninput:hover {\n  cursor: text;\n}\nbutton {\n  width: 200px;\n  height: 40px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background-color: #546e7a;\n  color: whitesmoke;\n  border-radius: 0.2rem;\n  margin-left: 200px;\n  font-weight: 500;\n  box-shadow: 1px 1px 1px 1px #302f2f;\n  font-size: 18px;\n}\ninput::placeholder {\n  color: #999898;\n  font-size: 13px;\n}\n.header {\n  height: auto;\n  color: whitesmoke;\n  font-size: 25px;\n  box-shadow: 5px 10px 18px #201f1f;\n  background-color: #546e7a;\n}\n.header-text {\n  color: whitesmoke;\n  font-size: 20px;\n  padding-top: 10px;\n  margin-top: 10px;\n  font-weight: 500;\n}\n.cross {\n  font-size: 1.4em;\n  padding-right: 5px;\n}\na {\n  color: whitesmoke;\n  text-decoration: none;\n  padding-top: 10px;\n}\nimg {\n  width: 50px;\n  height: 60px;\n}\n.message {\n  display: flex;\n  justify-content: center;\n  padding-top: 60px;\n  font-size: 19px;\n  width: 100%;\n}\n.inputLable {\n  height: 20px;\n  width: 500px !important;\n}\n.home-page {\n  margin-top: 30px;\n}\nimg {\n  padding-top: 5px;\n  padding-left: 50px;\n}\n.back {\n  color: whitesmoke;\n  position: absolute;\n  font-size: 15px;\n  top: 8px;\n}\nlabel {\n  color: whitesmoke;\n  font-size: 15px;\n}\n\ni {\n  color: whitesmoke;\n  margin-left: 20px;\n  margin-right: 5px;\n}\n.anchor {\n  font-size: 15px;\n}\n\n@media only screen and (max-width: 650px) {\n  .formBlock{\n    width: 500px;\n    height: 420px;\n  }\n}\n\n@media only screen and (max-width: 440px) {\n  .formBlock{\n    width: 370px;\n    height: 480px;\n  }\n}\n"
        },
