          "mimeType" : "text/html; charset=utf-8",
          "text" : "<!DOCTYPE html>\n<html>\n<!--LAB_HEAD_START-->\n    <head>\n        <link href=/resources/labheader/css/academyLabHeader.css rel=stylesheet>\n        <link href=/resources/css/labsEcommerce.css rel=stylesheet>\n        <title>Authentication bypass via flawed state machine</title>\n    </head>\n<!--LAB_HEAD_END-->\n    <body>\n        <script src=\"/resources/labheader/js/labHeader.js\"></script>\n        <!--LAB_HEADER_START-->\n        <div id=\"academyLabHeader\">\n            <section class='academyLabBanner'>\n                <div class=container>\n                    <div class=logo></div>\n                        <div class=title-container>\n                            <h2>Authentication bypass via flawed state machine</h2>\n                            <a class=link-back href='https://portswigger.net/web-security/logic-flaws/examples/lab-logic-flaws-authentication-bypass-via-flawed-state-machine'>\n                                Back&nbsp;to&nbsp;lab&nbsp;description&nbsp;\n                                <svg version=1.1 id=Layer_1 xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' x=0px y=0px viewBox='0 0 28 30' enable-background='new 0 0 28 30' xml:space=preserve title=back-arrow>\n                                    <g>\n                                        <polygon points='1.4,0 0,1.2 12.6,15 0,28.8 1.4,30 15.1,15'></polygon>\n                                        <polygon points='14.3,0 12.9,1.2 25.6,15 12.9,28.8 14.3,30 28,15'></polygon>\n                                    </g>\n                                </svg>\n                            </a>\n                        </div>\n                        <div class='widgetcontainer-lab-status is-notsolved'>\n                            <span>LAB</span>\n                            <p>Not solved</p>\n                            <span class=lab-status-icon></span>\n                        </div>\n                    </div>\n                </div>\n            </section>\n        </div>\n        <!--LAB_HEADER_END-->\n        <div theme=\"ecommerce\">\n            <section class=\"maincontainer\">\n                <div class=\"container\">\n                    <header class=\"navigation-header\">\n                        <section class=\"top-links\">\n                            <a href=/>Home</a><p>|</p>\n                            <a href=\"/my-account?id=wiener\">My account</a><p>|</p>\n                        </section>\n                    </header>\n                    <header class=\"notification-header\">\n                    </header>\n                    <section class=\"ecoms-pageheader\">\n                        <img src=\"/resources/images/shop.svg\">\n                    </section>\n                    <section class=\"container-list-tiles\">\n                        <div>\n                            <img src=\"/image/productcatalog/products/5.jpg\">\n                            <h3>Cheshire Cat Grin</h3>\n                            <img src=\"/resources/images/rating2.png\">\n                            $74.50\n                            <a class=\"button\" href=\"/product?productId=1\">View details</a>\n                        </div>\n                        <div>\n                            <img src=\"/image/productcatalog/products/15.jpg\">\n                            <h3>Pet Experience Days</h3>\n                            <img src=\"/resources/images/rating5.png\">\n                            $72.90\n                            <a class=\"button\" href=\"/product?productId=2\">View details</a>\n                        </div>\n                        <div>\n                            <img src=\"/image/productcatalog/products/6.jpg\">\n                            <h3>Com-Tool</h3>\n                            <img src=\"/resources/images/rating4.png\">\n                            $3.15\n                            <a class=\"button\" href=\"/product?productId=3\">View details</a>\n                        </div>\n                        <div>\n                            <img src=\"/image/productcatalog/products/39.jpg\">\n                            <h3>Paintball Gun - Thunder Striker</h3>\n                            <img src=\"/resources/images/rating5.png\">\n                            $7.37\n                            <a class=\"button\" href=\"/product?productId=4\">View details</a>\n                        </div>\n                        <div>\n                            <img src=\"/image/productcatalog/products/54.jpg\">\n                            <h3>Robot Home Security Buddy</h3>\n                            <img src=\"/resources/images/rating4.png\">\n                            $53.12\n                            <a class=\"button\" href=\"/product?productId=5\">View details</a>\n                        </div>\n                        <div>\n                            <img src=\"/image/productcatalog/products/30.jpg\">\n                            <h3>Giant Pillow Thing</h3>\n                            <img src=\"/resources/images/rating3.png\">\n                            $86.34\n                            <a class=\"button\" href=\"/product?productId=6\">View details</a>\n                        </div>\n                        <div>\n                            <img src=\"/image/productcatalog/products/42.jpg\">\n                            <h3>Pest Control Umbrella</h3>\n                            <img src=\"/resources/images/rating5.png\">\n                            $90.88\n                            <a class=\"button\" href=\"/product?productId=7\">View details</a>\n                        </div>\n                        <div>\n                            <img src=\"/image/productcatalog/products/37.jpg\">\n                            <h3>The Giant Enter Key</h3>\n                            <img src=\"/resources/images/rating4.png\">\n                            $14.71\n                            <a class=\"button