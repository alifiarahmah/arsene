          "cookies": [],
          "content": {
            "size": 2846,
            "mimeType": "text/html",
            "text": "<!DOCTYPE html>\n<html lang=\"en\">\n\t<head>\n\t\t\t<!-- Latest compiled and minified CSS -->\n\t\t<link rel=\"stylesheet\" href=\"../css/bootstrap.min.css\">\n\n\t\t<!-- Optional theme -->\n\t\t<!-- Latest compiled and minified JavaScript -->\n\t\t\t\t<script src='../js/jquery.min.js'></script>\n\t\t<script src=\"../js/bootstrap.min.js\"></script>\n\n        <script src='../js/angular.min.js'></script>\n\n\n\t\t<title>Login</title>\n\t</head>\n\t<body ng-app=''>\n\n\t\t\t<div class=\"jumbotron jumbotron-fluid\" style=\"margin-bottom: 0 !important;\">\n\t\t\t\t<div class=\"container\">\n\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t<div class=\"col-4\">\n\t\t\t\t\t\t\t<img src=\"/images/pixi_logo.png\" height=\"200\">\n\t\t\t\t\t\t  \n\t\t\t\t  \t\t</div>\n\t\t\t\t  \t\t<div class=\"col-8\" style=\"margin-top:5em;\">\n\t\t\t\t  \t\t\t<h1 class=\"display-3\">Hello, Pixi!</h1> \n\t\t\t\t\t\t\t  <p class=\"lead\">This is a social place where creators can earn virtual currency for their work.</p>\t\t\n\t\t\t\t  \t\t</div>\n\n\t\t\t\t   </div>\n\t\t\t\t   <br>\n\t\t\t\t   <hr>\n\t\t\t\t   <br>\n\n\t\t\t\t   <div class=\"row\">\n\n\t\t\t\t\t\t<div class=\"col-8\">\n\t\t\t\t\n\t\t\t\t\t\t\t <h2>Register for Pixi</h2>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t<form action='/register' method='POST'>\n\t\t\t\t\t\t\t\t  <div class=\"form-group\">\n\n\t\t\t\t\t\t\t\t    <label for=\"exampleInputEmail1\">Email address</label>\n\t\t\t\t\t\t\t\t    <input type=\"email\" class=\"form-control form-control-lg\" id=\"email\" name=\"email\" aria-describedby=\"emailHelp\" placeholder=\"Enter email\">\n\t\t\t\t\t\t\t\t    <small id=\"emailHelp\" class=\"form-text text-muted\">We'll never share your email with anyone else.</small>\n\t\t\t\t\t\t\t\t  </div>\n\t\t\t\t\t\t\t\t  <div class=\"form-group\">\n\t\t\t\t\t\t\t\t    <label for=\"password\">Password</label>\n\t\t\t\t\t\t\t\t    <input type=\"password\" class=\"form-control form-control-lg\" id=\"password\" name=\"password\" placeholder=\"Password\">\n\t\t\t\t\t\t\t\t  </div>\n\t\t\t\t\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t\t\t<button type=\"submit\" class=\"btn btn-lg btn-info\">Login</button>\n\t\t\t\t\t\t\t\n\t\t\t\t\t\t\t\t</form>\n\t\t\t\t\t\t\t\t<br>\n\t\t\t\t\t\t\t\t<h2 class=\"alert-heading\" id=\"message\"></h2>\n\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<div class=\"col-4\" style=\"border-left: 1px solid; padding:3em;\">\n\t\t\t\t\t\t\t\t<h2> Have an account? </h2> <br>\n\t\t\t\t\t\t\t\t<a href=\"/login\"><button type=\"button\" class=\"btn btn-lg btn-info\">Login!</button></a>\n\t\t\t\t\t\t\t\t<br><br>\n\t\t\t\t\t\t\t\t<a href=\"http://www.owasp.org\"><img src=\"/images/owasp_logo_1c.png\" width=\"400\"></a>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t  </div>\n\t\t\t \t\t\t\n\t\t\n\n\t\t</div>\n\n\t\t\n\t\t<script>\n\t\t\t//get params from URL\n\t\t\tvar params={};\n\t\t\twindow.location.search\n\t\t\t  .replace(/[?&]+([^=&]+)=([^&]*)/gi, function(str,key,value) {\n\t\t\t    params[key] = decodeURIComponent(value);\n\t\t\t  });\n\t\t\t//if user param, print message\t\n\t\t\tif(params['user']){\n\t\t\t\t//using jQuery .text() only encodes HTML control characters, .html() encodes nothing \n\t\t\t\t$('#message').text(\"Please enter a user name and a password! \" + params['user'] + \"!\");\n\t\t\t}\t\n\t\t</script>\n\t</div>\n<div class=\"container-fluid\" style=\"height:500px; background-color:#5bc0de;\">\n\n\t    </div>\n\t\n\t</body>\n</HTML>\n\n\n\n"
          },
