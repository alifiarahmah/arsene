          "mimeType" : "text/html; charset=utf-8",
          "text" : "<!DOCTYPE html>\n<html>\n<!--LAB_HEAD_START-->\n    <head>\n        <link href=/resources/labheader/css/academyLabHeader.css rel=stylesheet>\n        <link href=/resources/css/labs.css rel=stylesheet>\n        <title>High-level logic vulnerability</title>\n    </head>\n<!--LAB_HEAD_END-->\n    <body>\n        <script src=\"/resources/labheader/js/labHeader.js\"></script>\n        <!--LAB_HEADER_START-->\n        <div id=\"academyLabHeader\">\n            <section class='academyLabBanner'>\n                <div class=container>\n                    <div class=logo></div>\n                        <div class=title-container>\n                            <h2>High-level logic vulnerability</h2>\n                            <a class=link-back href='https://portswigger.net/web-security/logic-flaws/examples/lab-logic-flaws-high-level'>\n                                Back&nbsp;to&nbsp;lab&nbsp;description&nbsp;\n                                <svg version=1.1 id=Layer_1 xmlns='http://www.w3.org/2000/svg' xmlns:xlink='http://www.w3.org/1999/xlink' x=0px y=0px viewBox='0 0 28 30' enable-background='new 0 0 28 30' xml:space=preserve title=back-arrow>\n                                    <g>\n                                        <polygon points='1.4,0 0,1.2 12.6,15 0,28.8 1.4,30 15.1,15'></polygon>\n                                        <polygon points='14.3,0 12.9,1.2 25.6,15 12.9,28.8 14.3,30 28,15'></polygon>\n                                    </g>\n                                </svg>\n                            </a>\n                        </div>\n                        <div class='widgetcontainer-lab-status is-notsolved'>\n                            <span>LAB</span>\n                            <p>Not solved</p>\n                            <span class=lab-status-icon></span>\n                        </div>\n                    </div>\n                </div>\n            </section>\n        </div>\n        <!--LAB_HEADER_END-->\n        <div theme=\"\">\n            <section class=\"maincontainer\">\n                <div class=\"container is-page\">\n                    <header class=\"navigation-header\">\n                        <p><strong>Store credit: $100.00</strong></p>\n                        <section class=\"top-links\">\n                            <a href=/>Home</a><p>|</p>\n                            <a href=\"/my-account?id=wiener\">My account</a><p>|</p>\n                            <a href=/cart>\n                                <img src=/resources/images/cart_blue.svg />\n                            </a>\n                            <p>3</p>\n                            <p>|</p>\n                        </section>\n                    </header>\n                    <header class=\"notification-header\">\n                    </header>\n                    <p><strong>Cart</strong></p>\n                    <table id='cart-items'>\n                        <tbody>\n                            <tr>\n                                <th>Name</th>\n                                <th>Price</th>\n                                <th>Quantity</th>\n                                <th></th>\n                            </tr>\n                            <tr>\n                                <td>\n                                    <a href=/product?productId=17>There is No &apos;I&apos; in Team</a>\n                                </td>\n                                <td>$52.76</td>\n                                <td>\n                                    <form action=/cart method=POST style='display: inline'>\n                                        <input required type=hidden name=productId value=17>\n                                        <input required type=hidden name=quantity value=-1>\n                                        <input required type=hidden name=redir value=CART>\n                                        <button type=submit class=button style='min-width: auto'>-</button>\n                                    </form>\n                                    1\n                                    <form action=/cart method=POST style='display: inline'>\n                                        <input required type=hidden name=productId value=17>\n                                        <input required type=hidden name=quantity value=1>\n                                        <input required type=hidden name=redir value=CART>\n                                        <button type=submit class=button style='min-width: auto'>+</button>\n                                    </form>\n                                </td>\n                                <td>\n                                    <form action=/cart method=POST style='display: inline'>\n                                        <input required type=hidden name=productId value=17>\n                                        <input required type=hidden name=quantity value=-1>\n                                        <input required type=hidden name=redir value=CART>\n                                        <button type=submit class=button style='min-width: auto'>Remove</button>\n                                    </form>\n                                </td>\n                            </tr>\n                            <tr>\n                                <td>\n                                    <a href=/product?productId=8>Eggtastic, Fun, Food Eggcessories</a>\n                                </td>\n                                <td>$16.73</td>\n                                <td>\n                                    <form action=/cart method=POST style='display: inline'>\n                                        <input required type=hidden name=productId value=8>\n                                        <input required type=hidden name=quantity value=-1>\n                                        <input required type=hidden name=redir value=CART>\n                                        <button type=submit class=button style='min-width: auto'>-</button>\n                                    </form>\n                                    2\n                                    <form action=/cart method=POST style='display: inline'>\n                                        <input required type=hidden name=productId value=8>\n                                        <input required type=hidden name=quantity value=1>\n                                        <input required type=hidden name=redir value=CART>\n                                        <button type=submit class=button style='min-width: auto'>+</button>\n                                    </form>\n                                </td>\n                                <td>\n                                    <form action=/cart method=POST style='display: inline'>\n                                        <input required type=hidden name=productId value=8>\n                                        <input required type=hidden name=quantity value=-2>\n                                        <input required type=hidden name=redir value=CART>\n                                        <button type=submit class=button style='min-width: auto'>Remove</button>\n                                    </form>\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <form class=login-form id=coupon-form action=/cart/coupon method=POST >\n                        <label>Coupon:</label>\n                        <input required type=\"hidden\" name=\"csrf\" value=\"njLMLYBJnQLziW6BR03u9WEH3ZAEnTPO\">\n                        <input required placeholder=\"Add coupon\" type=text name=coupon>\n                        <button class=button type=submit>Apply</button>\n                    </form>\n                    <table>\n                        <tbody>\n                            <tr>\n                                <th>Total:</th>\n                                <th>$86.22</th>\n                            </tr>\n                        </tbody>\n                    </table>\n                    <form class=login-form action=/cart/checkout method=POST>\n                        <input required type=\"hidden\" name=\"csrf\" value=\"njLMLYBJnQLziW6BR03u9WEH3ZAEnTPO\">\n                        <button class=button type=submit>Place order</button>\n                    </form>\n                </div>\n            </section>\n            <div class=\"footer-wrapper\">\n            </div>\n        </div>\n    </body>\n</html>\n"
