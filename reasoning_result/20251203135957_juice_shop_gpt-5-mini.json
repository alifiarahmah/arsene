{
  "test_cases": [
    {
      "id": "plan-auth-1",
      "hypothesis_id": "auth-flow",
      "base_url": "http://localhost:3000",
      "method": "POST",
      "endpoint": "/rest/user/login",
      "parameter": "body",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "body",
              "value": "{\"email\":\"dummy@mail.com\",\"password\":\"dummy\"}"
            }
          ],
          "description": "Authenticate using observed credentials to obtain JWT/session (baseline)",
          "encoding": "json",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "{\"email\":\"dummy@mail.com\",\"password\":\"wrong\"}"
            }
          ],
          "description": "Verify failure path and observe status codes/headers for login",
          "encoding": "json",
          "content_type": "application/json",
          "header": []
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "Successful login returns auth token in response while failure does not; detect token issuance",
          "threshold": {
            "expected_codes": [
              200,
              401,
              403
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "Login success response body differs significantly from failure (>=30%)",
          "threshold": {
            "body_length_delta_pct": 30.0
          },
          "weight": 0.7
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 4
      },
      "max_retries": 1,
      "delay_between_requests": 1.0,
      "notes": "Primary prerequisite: obtain JWT token. Extract token from response body or Authorization header and bind to subsequent tests as Authorization: Bearer <token>. Stop further authenticated tests if login fails.",
      "tags": [
        "authentication"
      ],
      "estimated_duration": 60
    },
