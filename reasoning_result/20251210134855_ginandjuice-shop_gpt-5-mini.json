      "id": "EXEC-06-TEST-REFLECTED-XSS",
      "hypothesis_id": "H005",
      "base_url": "https://example.com",
      "method": "POST",
      "endpoint": "/catalog/subscribe",
      "parameter": "email",
      "payloads": [
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "test@example.com"
            },
            {
              "location": "body",
              "value": "&lt;script&gt;alert(1)&lt;/script&gt;"
            },
            {
              "location": "body",
              "value": "\"'&gt;&lt;img src=x onerror=alert(1)&gt;"
            }
          ],
          "description": "Inject common reflected XSS payloads into email parameter while supplying valid CSRF token to detect reflection",
          "encoding": "json",
          "content_type": "application/json;charset=UTF-8",
          "header": [
            {
              "header_name": "Content-Type",
              "header_value": "application/json;charset=UTF-8"
            }
          ]
        }
      ],
      "prerequisites": [
        {
          "type": "csrf_token",
          "description": "Valid CSRF token required for submission; include valid token to reach reflection handling"
        }
      ],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "Submitted email value is reflected verbatim or altered in response body indicating potential reflected XSS",
          "threshold": {
            "body_length_delta_pct": 20.0
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "Response length changes by >=30% when injecting test strings into email parameter",
          "threshold": {
            "body_length_delta_pct": 30.0
          },
          "weight": 0.7
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 30
      },
      "max_retries": 1,
      "delay_between_requests": 1.0,
      "notes": "Use encoded/benign payload variants to avoid accidental JS execution in tooling. Only analyze response bodies for reflection; do not attempt DOM execution.",
      "tags": [
        "xss",
        "reflected"
      ],
      "estimated_duration": 10
    },
