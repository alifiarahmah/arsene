    {
      "id": "EXEC-05-TEST-CSRF-ENFORCEMENT",
      "hypothesis_id": "H004",
      "base_url": "https://example.com",
      "method": "POST",
      "endpoint": "/catalog/subscribe",
      "parameter": "csrf",
      "payloads": [
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "MISSING"
            },
            {
              "location": "body",
              "value": "invalid-token"
            },
            {
              "location": "body",
              "value": "sRlHA2cQXlSVetz3ApxB4TLvIoiRwTpZ"
            }
          ],
          "description": "Submit subscription with missing, invalid, and observed valid CSRF token to verify CSRF enforcement",
          "encoding": "json",
          "content_type": "application/json;charset=UTF-8",
          "header": [
            {
              "header_name": "Content-Type",
              "header_value": "application/json;charset=UTF-8"
            }
          ]
        }
      ],
      "prerequisites": [
        {
          "type": "csrf_token",
          "description": "Valid CSRF token observed in context; include known sample token for valid case"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "Missing/invalid CSRF token yields rejection codes vs accepted codes for valid token",
          "threshold": {
            "expected_codes": [
              200,
              201,
              403,
              401,
              400
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "error_signature",
          "condition": "Response body contains server-side error or stack trace when CSRF handling fails",
          "threshold": {},
          "weight": 0.7
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 20
      },
      "max_retries": 1,
      "delay_between_requests": 1.0,
      "notes": "Ensure email uses benign test@example.com. Bind CSRF token extracted from JS or prior GET to JSON body field 'csrf'. Stop if valid token case succeeds to avoid spamming.",
      "tags": [
        "csrf",
        "state-changing"
      ],
      "estimated_duration": 5
    },
