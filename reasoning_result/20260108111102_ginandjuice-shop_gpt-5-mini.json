{
  "test_cases": [
    {
      "id": "TC-H-17-01",
      "hypothesis_id": "H-17-csrf-state-change",
      "base_url": "https://example.com",
      "method": "POST",
      "endpoint": "/catalog/subscribe",
      "parameter": "email",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "body",
              "value": "{\"email\":\"mail@example.com\",\"csrf\":\"sRlHA2cQXlSVetz3ApxB4TLvIoiRwTpZ\"}"
            }
          ],
          "description": "Submit subscription with observed CSRF token to confirm expected success",
          "encoding": "utf-8",
          "content_type": "application/json; charset=utf-8",
          "header": [
            {
              "header_name": "Content-Type",
              "header_value": "application/json; charset=utf-8"
            }
          ]
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "{\"email\":\"mail+probe@example.com\",\"csrf\":\"\"}"
            }
          ],
          "description": "Submit subscription with empty CSRF to test server-side CSRF enforcement",
          "encoding": "utf-8",
          "content_type": "application/json; charset=utf-8",
          "header": [
            {
              "header_name": "Content-Type",
              "header_value": "application/json; charset=utf-8"
            }
          ]
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "{\"email\":\"mail+replay@example.com\",\"csrf\":\"sRlHA2cQXlSVetz3ApxB4TLvIoiRwTpZ\"}"
            }
          ],
          "description": "Replay observed CSRF token to test token reuse acceptance",
          "encoding": "utf-8",
          "content_type": "application/json; charset=utf-8",
          "header": [
            {
              "header_name": "Content-Type",
              "header_value": "application/json; charset=utf-8"
            }
          ]
        }
      ],
      "prerequisites": [
        {
          "type": "csrf_token",
          "description": "Observed CSRF token from prior traffic",
          "bind_to": "csrf"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "Request with valid CSRF returns status code in [200,201,204,302]",
          "threshold": {
            "expected_codes": [
              200,
              201,
              204,
              302
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "authentication_bypassed",
          "condition": "Request with empty CSRF or replayed CSRF also returns success code from expected_codes or causes state change",
          "threshold": {},
          "weight": 0.8
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 20
      },
      "max_retries": 1,
      "delay_between_requests": 1.0,
      "notes": "Validates CSRF enforcement and token reuse policy using observed token sRlHA2cQXlSVetz3ApxB4TLvIoiRwTpZ",
      "tags": [
        "csrf",
        "state-change"
      ],
      "estimated_duration": 30
    },
    {
      "id": "TC-H-10-01",
      "hypothesis_id": "H-10-dom-xss-reflection",
      "base_url": "https://example.com",
      "method": "GET",
      "endpoint": "/catalog/product",
      "parameter": "productId",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query",
              "value": "17"
            }
          ],
          "description": "Baseline request with original sample value",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "17<unique>INJECTION"
            }
          ],
          "description": "Inject a unique marker with angle brackets to check for DOM reflection in HTML/JS contexts",
          "header": []
        }
      ],
      "prerequisites": [
        {
          "type": "custom",
          "description": "Compare response body and DOM reflection between baseline and probe",
          "custom_logic": "Fetch baseline then probe; preserve cookies/headers between requests"
        }
      ],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "response contains literal substring \"17<unique>INJECTION\" in HTML or JS payloads",
          "threshold": {},
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "probe response body length >= 120% of baseline response body length",
          "threshold": {
            "body_length_delta_pct": 20.0
          },
          "weight": 0.5
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 50
      },
      "max_retries": 2,
      "delay_between_requests": 0.5,
      "notes": "Designed to detect DOM-based reflection of productId",
      "tags": [
        "xss",
        "dom",
        "probe"
      ],
      "estimated_duration": 60
    },
