    {
      "id": "tc-hv-1",
      "hypothesis_id": "hv-1",
      "base_url": "http://example.invalid",
      "method": "GET",
      "endpoint": "/js/jquery.min.js",
      "parameter": "url",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query",
              "value": "1"
            }
          ],
          "description": "Baseline benign value to establish normal response body and length",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "<script>/*x*/</script>"
            }
          ],
          "description": "Probe payload with harmless script-like token to detect reflection in JS/DOM contexts",
          "header": []
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "query",
              "value": "\"+alert(1)+\""
            }
          ],
          "description": "Aggressive DOM-style payload attempting to break out of JS context (use only if probe indicates reflection)",
          "header": []
        }
      ],
      "prerequisites": [
        {
          "type": "session_state",
          "description": "Existing authenticated session cookie required (observed cookie-based session management)",
          "bind_to": "Cookie: auth_cookie_session=<observed_session_value>"
        },
        {
          "type": "csrf_token",
          "description": "CSRF token present in cookies (observed auth_cookie_CSRF-TOKEN) if required by app for GETs",
          "bind_to": "Cookie: auth_cookie_CSRF-TOKEN=<observed_csrf_value>"
        }
      ],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "response body or returned JS contains exact payload string from query parameter 'url'",
          "threshold": {
            "body_length_delta_pct": 10.0,
            "expected_codes": [
              200
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "response body length differs by >=10% between benign and probe requests for same endpoint and parameter set",
          "threshold": {
            "body_length_delta_pct": 10.0,
            "expected_codes": [
              200
            ]
          },
          "weight": 0.5
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 10
      },
      "max_retries": 2,
      "delay_between_requests": 0.5,
      "notes": "Use observed session and CSRF cookie values from harvest; base_url set to example.invalid because real host must be taken from observation. If tokens not available, test cannot run.",
      "tags": [
        "xss",
        "dom",
        "regex-reflection"
      ],
      "estimated_duration": 60
    },
