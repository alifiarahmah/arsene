              "value": "sRlHA2cQXlSVetz3ApxB4TLvIoiRwTpZ"
            }
          ],
          "description": "Stored XSS probe payload in email field to detect reflection/storage in subsequent GETs. Proceed only if observation prerequisite satisfied.",
