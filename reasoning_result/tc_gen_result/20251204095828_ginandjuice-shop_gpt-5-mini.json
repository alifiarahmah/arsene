          "custom_logic": "Fetch subscription confirmation or listing pages after benign submission to establish baseline for reflection check."
        }
      ],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "After submission, fetch subscription-related pages; if the submitted email string appears in response unencoded or as raw HTML (e.g., contains '<script>alert(1)</script>'), flag stored XSS.",
          "threshold": {
            "expected_codes": [
              200,
              201
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "If subscription page body length increases by >=30% after submission compared to baseline, and contains submitted marker, flag as stored content.",
          "threshold": {
            "body_length_delta_pct": 30.0
          },
          "weight": 0.5
        }
      ],
      "pass_logic": "all",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 10
      },
      "max_retries": 2,
