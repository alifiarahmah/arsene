    {
      "id": "tc-idor-put-addresss-id",
      "hypothesis_id": "idor-put-addresss-id",
      "base_url": "http",
      "method": "PUT",
      "endpoint": "/api/Addresss/{id}",
      "parameter": "id",
      "payloads": [
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "path",
              "value": "6"
            },
            {
              "location": "path",
              "value": "8"
            }
          ],
          "description": "Vary path id to detect IDOR",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "body",
              "value": "{\"country\":\"Indonesia\",\"fullName\":\"homee\",\"mobileNum\":\"6277711133\",\"zipCode\":\"144444\",\"streetAddress\":\"Jl. Raya No. 1\",\"city\":\"Bandung\",\"state\":\"Jawa Barat\"}"
            }
          ],
          "description": "Baseline body",
          "content_type": "application/json",
          "header": []
        }
      ],
      "prerequisites": [
        {
          "type": "login",
          "description": "Authenticated session (jwt or cookie)"
        },
        {
          "type": "session_state",
          "description": "Have at least one own address id to compare"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "non_owner_id vs owner_id",
          "threshold": {
            "expected_codes": [
              200,
              201,
              204,
              401,
              403,
              404
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "compare bodies owner vs non-owner",
          "threshold": {
            "body_length_delta_pct": 25.0
          },
          "weight": 0.8
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 3
      },
      "max_retries": 1,
      "delay_between_requests": 0.2,
      "tags": [
