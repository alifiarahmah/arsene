    {
      "id": "tc-hyp-GET-4-xss_reflected-user-1",
      "hypothesis_id": "hyp-GET-4-xss_reflected-user",
      "base_url": "http://localhost:8000",
      "method": "GET",
      "endpoint": "4",
      "parameter": "user",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query.user",
              "value": "mail@example.com"
            }
          ],
          "description": "Baseline benign user value",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query.user",
              "value": "<svg/onload=alert(1)>"
            }
          ],
          "description": "XSS probe payload in user parameter",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query.user",
              "value": "\"'><img src=x onerror=alert(1)>"
            }
          ],
          "description": "Attribute/context breaking XSS probe",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query.user",
              "value": "{{7*7}}"
            }
          ],
          "description": "Template expression probe",
          "header": []
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "status_probe in [200] and any(p in body_probe for p in [\"<svg/onload=alert(1)>\",\"\\\"'><img src=x onerror=alert(1)>\",\"{{7*7}}\"] )",
          "threshold": {
            "expected_codes": [
              200
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "status_base==200 and status_probe==200 and abs(len(body_probe)-len(body_base))/max(len(body_base),1)*100 >= 20.0",
          "threshold": {
            "body_length_delta_pct": 20.0,
            "expected_codes": [
              200
            ]
          },
          "weight": 0.5
        },
        {
          "signal": "error_signature",
          "condition": "status_probe in [400,500] or any(s in body_probe for s in [\"template\",\"render\",\"syntax\",\"Unexpected token\"])",
          "threshold": {
            "expected_codes": [
              400,
              500
            ]
          },
          "weight": 0.5
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 5
      },
      "max_retries": 1,
      "delay_between_requests": 0.2,
      "tags": [
        "xss_reflected",
        "query-param"
      ],
      "estimated_duration": 2
    },
