    {
      "id": "tc-hv-004-1",
      "hypothesis_id": "hv-004",
      "base_url": "http://{host}",
      "method": "GET",
      "endpoint": "/socket.io/",
      "parameter": "sid",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query",
              "value": "?sid=static-test"
            }
          ],
          "description": "Baseline fetch with safe sid value to observe normal behavior.",
          "encoding": "utf-8",
          "content_type": "*/*",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "?sid=example.com.xb.*.attacker-ctf.net"
            }
          ],
          "description": "Probe with attacker-controlled domain-looking sid to attempt SSRF/OOB trigger. Use single request due to safety.",
          "encoding": "utf-8",
          "content_type": "*/*",
          "header": []
        }
      ],
      "prerequisites": [
        {
          "type": "custom",
          "description": "OOB domain configured to detect DNS/HTTP callbacks; external monitoring must be enabled by operator before running.",
          "custom_logic": "use operator-provided OOB domain in query value"
        }
      ],
      "oracle_rules": [
        {
          "signal": "dns_callback",
          "condition": "oob_dns_seen_for_subdomain",
          "weight": 1.0
        },
        {
          "signal": "http_callback",
          "condition": "oob_http_seen_for_path",
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 1
      },
      "max_retries": 1,
      "delay_between_requests": 0.5,
      "notes": "Requires external OOB collaborator. Do not perform if OOB endpoint unavailable. Only one probe allowed.",
      "tags": [
        "ssrf",
        "socket.io"
      ],
      "estimated_duration": 300
    },
    {
