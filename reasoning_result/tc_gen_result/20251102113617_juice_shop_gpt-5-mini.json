{
  "test_cases": [
    {
      "id": "tc-hv-001-1",
      "hypothesis_id": "hv-001",
      "base_url": "http://{host}",
      "method": "GET",
      "endpoint": "/rest/user/whoami",
      "parameter": "authorization",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "header",
              "value": "authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..NvVTXZsk8zrJqC1BIESlmzmMwy3o646U8KHx0Y8bu1Vf-tqIp5oii9hatVub2JERDq9OYCEHaM8wPJBlZvAI8QLm3GUBgWITFO7d_sCWHEuvAY1XMZYcDxgtoP08Wxv0H9_NZVGBQ7wMddu0tWLMwPjhxmtO4MoypcLEhMoNxOg"
            }
          ],
          "description": "Baseline valid bearer token request to capture status and body length.",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "header",
              "value": "authorization: Bearer invalid.token.for.testing"
            }
          ],
          "description": "Probe with invalid/garbled bearer token to observe status and error messages.",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "header",
              "value": "authorization: "
            },
            {
              "location": "header",
              "value": "authorization: Bearer "
            },
            {
              "location": "header",
              "value": "authorization: Bearer null"
            }
          ],
          "description": "Attempts with missing/empty/placeholder Authorization header to detect auth bypass behavior.",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": []
        }
      ],
      "prerequisites": [
        {
          "type": "jwt_refresh",
          "description": "Valid bearer token already observed in context; use as-is.",
          "bind_to": "authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..NvVTXZsk8zrJqC1BIESlmzmMwy3o646U8KHx0Y8bu1Vf-tqIp5oii9hatVub2JERDq9OYCEHaM8wPJBlZvAI8QLm3GUBgWITFO7d_sCWHEuvAY1XMZYcDxgtoP08Wxv0H9_NZVGBQ7wMddu0tWLMwPjhxmtO4MoypcLEhMoNxOg"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "compare_status_to_baseline",
          "threshold": {
            "expected_codes": [
              200,
              401,
              403
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "body_length_delta_pct >= 30",
          "threshold": {
            "body_length_delta_pct": 30.0,
            "numeric_value": 30.0
          },
          "weight": 1.0
        },
        {
          "signal": "error_signature",
          "condition": "response_body_contains(token, authentication, invalid, malformed, expired)",
          "weight": 0.8
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 5
      },
      "max_retries": 2,
      "delay_between_requests": 0.5,
      "notes": "Execute benign then probes. Compare status and body length to baseline. Use observed bearer token for authenticated requests.",
      "tags": [
        "authn_bypass",
        "bearer_token"
      ],
      "estimated_duration": 60
    },
    {
      "id": "tc-hv-002-1",
      "hypothesis_id": "hv-002",
      "base_url": "http://{host}",
      "method": "GET",
      "endpoint": "/rest/basket/{basketId}",
      "parameter": "basketId",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "path",
              "value": "/rest/basket/6"
            }
          ],
          "description": "Baseline request to own basketId=6 (authenticated non-owner context uses provided token).",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": [
            {
              "header_name": "authorization",
              "header_value": "Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..NvVTXZsk8zrJqC1BIESlmzmMwy3o646U8KHx0Y8bu1Vf-tqIp5oii9hatVub2JERDq9OYCEHaM8wPJBlZvAI8QLm3GUBgWITFO7d_sCWHEuvAY1XMZYcDxgtoP08Wxv0H9_NZVGBQ7wMddu0tWLMwPjhxmtO4MoypcLEhMoNxOg"
            }
          ]
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "path",
              "value": "/rest/basket/7"
            }
          ],
          "description": "Probe using adjacent basketId=7 (non-owned) to detect access differences.",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": [
            {
              "header_name": "authorization",
              "header_value": "Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..NvVTXZsk8zrJqC1BIESlmzmMwy3o646U8KHx0Y8bu1Vf-tqIp5oii9hatVub2JERDq9OYCEHaM8wPJBlZvAI8QLm3GUBgWITFO7d_sCWHEuvAY1XMZYcDxgtoP08Wxv0H9_NZVGBQ7wMddu0tWLMwPjhxmtO4MoypcLEhMoNxOg"
            }
          ]
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "path",
              "value": "/rest/basket/1"
            },
            {
              "location": "path",
              "value": "/rest/basket/10"
            }
          ],
          "description": "Iterate over other candidate basketIds to detect IDOR; use non-owner authenticated token. Stop if access returns 200 and body significantly different from baseline.",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": [
            {
              "header_name": "authorization",
              "header_value": "Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..NvVTXZsk8zrJqC1BIESlmzmMwy3o646U8KHx0Y8bu1Vf-tqIp5oii9hatVub2JERDq9OYCEHaM8wPJBlZvAI8QLm3GUBgWITFO7d_sCWHEuvAY1XMZYcDxgtoP08Wxv0H9_NZVGBQ7wMddu0tWLMwPjhxmtO4MoypcLEhMoNxOg"
            }
          ]
        }
      ],
      "prerequisites": [
        {
          "type": "jwt_refresh",
          "description": "Use authenticated non-owner token in Authorization header.",
          "bind_to": "authorization: Bearer eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1NiJ9..NvVTXZsk8zrJqC1BIESlmzmMwy3o646U8KHx0Y8bu1Vf-tqIp5oii9hatVub2JERDq9OYCEHaM8wPJBlZvAI8QLm3GUBgWITFO7d_sCWHEuvAY1XMZYcDxgtoP08Wxv0H9_NZVGBQ7wMddu0tWLMwPjhxmtO4MoypcLEhMoNxOg"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "baseline_status != probe_status or probe_status in [200,403,404]",
          "threshold": {
            "expected_codes": [
              200,
              403,
              404
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "abs(body_len_probe - body_len_baseline)/max(1,body_len_baseline) * 100 >= 40",
          "threshold": {
            "body_length_delta_pct": 40.0,
            "numeric_value": 40.0
          },
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 10
      },
      "max_retries": 3,
      "delay_between_requests": 0.5,
      "notes": "Send baseline to basketId 6 then probe other IDs. Compare status and body size. Stop if success observed for non-owner.",
      "tags": [
        "idor",
        "basket"
      ],
      "estimated_duration": 120
    },
