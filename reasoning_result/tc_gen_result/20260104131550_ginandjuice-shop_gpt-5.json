        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "17) --"
            },
            {
              "location": "query",
              "value": "17' --"
            }
          ],
          "description": "Comment termination patterns",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "17 UNION SELECT 1"
            }
          ],
          "description": "UNION-based SQLi light probe",
          "header": []
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "compare_to_baseline",
