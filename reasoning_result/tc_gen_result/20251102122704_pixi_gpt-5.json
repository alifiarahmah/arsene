{
  "test_cases": [
    {
      "id": "TC-H1-GET-/login-user",
      "hypothesis_id": "H1",
      "base_url": "",
      "method": "GET",
      "endpoint": "/login",
      "parameter": "query:user",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query:user",
              "value": "mail@example.com"
            }
          ],
          "description": "Baseline valid-looking user value",
          "header": [
            {
              "header_name": "upgrade-insecure-requests",
              "header_value": "1"
            },
            {
              "header_name": "user-agent",
              "header_value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36"
            },
            {
              "header_name": "sec-ch-ua",
              "header_value": "\"Chromium\";v=\"140\", \"Not=A?Brand\";v=\"24\", \"Google Chrome\";v=\"140\""
            },
            {
              "header_name": "content-type",
              "header_value": "application/x-www-form-urlencoded"
            },
            {
              "header_name": "origin",
              "header_value": "http://localhost:8000"
            },
            {
              "header_name": "referer",
              "header_value": "http://localhost:8000/"
            }
          ]
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query:user",
              "value": "../../../../../etc/passwd"
            }
          ],
          "description": "Traversal-ish probe to test auth handling quirks",
          "header": [
            {
              "header_name": "upgrade-insecure-requests",
              "header_value": "1"
            },
            {
              "header_name": "user-agent",
              "header_value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36"
            },
            {
              "header_name": "sec-ch-ua",
              "header_value": "\"Chromium\";v=\"140\", \"Not=A?Brand\";v=\"24\", \"Google Chrome\";v=\"140\""
            },
            {
              "header_name": "content-type",
              "header_value": "application/x-www-form-urlencoded"
            },
            {
              "header_name": "origin",
              "header_value": "http://localhost:8000"
            },
            {
              "header_name": "referer",
              "header_value": "http://localhost:8000/"
            }
          ]
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "query:user",
              "value": "%00admin"
            }
          ],
          "description": "Null byte attempt to bypass comparison logic",
          "header": [
            {
              "header_name": "upgrade-insecure-requests",
              "header_value": "1"
            },
            {
              "header_name": "user-agent",
              "header_value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36"
            },
            {
              "header_name": "sec-ch-ua",
              "header_value": "\"Chromium\";v=\"140\", \"Not=A?Brand\";v=\"24\", \"Google Chrome\";v=\"140\""
            },
            {
              "header_name": "content-type",
              "header_value": "application/x-www-form-urlencoded"
            },
            {
              "header_name": "origin",
              "header_value": "http://localhost:8000"
            },
            {
              "header_name": "referer",
              "header_value": "http://localhost:8000/"
            }
          ]
        }
      ],
      "prerequisites": [
        {
          "type": "session_state",
          "description": "Ensure no authenticated session cookies are sent to observe true unauthenticated behavior",
          "custom_logic": "clear cookies for domain before requests"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "compare each probe/exploit response code vs benign baseline",
          "threshold": {
            "expected_codes": [
              200,
              302,
              303,
              307,
              401,
              403,
              404,
              500,
              503,
              301,
              308,
              400,
              422,
              429
            ]
          },
          "weight": 0.5
        },
        {
          "signal": "response_length_diff",
          "condition": "absolute(body_length_delta_pct) >= threshold compared to benign",
          "threshold": {
            "body_length_delta_pct": 30.0
          },
          "weight": 0.3
        },
        {
          "signal": "error_signature",
          "condition": "response body contains common error markers",
          "threshold": {
            "string_value": "Exception|Traceback|stack trace|ValueError|TypeError|KeyError|NullReference|SQLSTATE|PDOException"
          },
          "weight": 0.2
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 5
      },
      "max_retries": 1,
      "delay_between_requests": 0.3,
      "tags": [
        "authn_bypass",
        "content-negotiation",
        "unauthenticated"
      ],
      "estimated_duration": 1
    },
    {
      "id": "TC-H2-POST-/upload_photo/-content-type",
      "hypothesis_id": "H2",
      "base_url": "",
      "method": "POST",
      "endpoint": "/upload_photo/",
      "parameter": "header:content-type",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "header:content-type",
              "value": "multipart/form-data; boundary=----WebKitFormBoundaryUzCwPZQIC5FBFc1k"
            }
          ],
          "description": "Baseline standard multipart upload header",
          "header": [
            {
              "header_name": "accept",
              "header_value": "application/json, text/plain, */*"
            },
            {
              "header_name": "referer",
              "header_value": "http://localhost:8000/pixi"
            },
            {
              "header_name": "user-agent",
              "header_value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36"
            },
            {
              "header_name": "sec-ch-ua",
              "header_value": "\"Chromium\";v=\"140\", \"Not=A?Brand\";v=\"24\", \"Google Chrome\";v=\"140\""
            },
            {
              "header_name": "x-csrf-token",
              "header_value": "CSRF-TOKEN"
            }
          ]
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "header:content-type",
              "value": "application/json"
            }
          ],
          "description": "Probe alternate parser path with JSON",
          "header": [
            {
              "header_name": "accept",
              "header_value": "application/json, text/plain, */*"
            },
            {
              "header_name": "referer",
              "header_value": "http://localhost:8000/pixi"
            },
            {
              "header_name": "user-agent",
              "header_value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36"
            },
            {
              "header_name": "sec-ch-ua",
              "header_value": "\"Chromium\";v=\"140\", \"Not=A?Brand\";v=\"24\", \"Google Chrome\";v=\"140\""
            },
            {
              "header_name": "x-csrf-token",
              "header_value": "CSRF-TOKEN"
            }
          ]
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "header:content-type",
              "value": "multipart/form-data; boundary=invalidboundary"
            }
          ],
          "description": "Malformed multipart boundary to trigger parser errors/info leaks",
          "header": [
            {
              "header_name": "accept",
              "header_value": "application/json, text/plain, */*"
            },
            {
              "header_name": "referer",
              "header_value": "http://localhost:8000/pixi"
            },
            {
              "header_name": "user-agent",
              "header_value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36"
            },
            {
              "header_name": "sec-ch-ua",
              "header_value": "\"Chromium\";v=\"140\", \"Not=A?Brand\";v=\"24\", \"Google Chrome\";v=\"140\""
            },
            {
              "header_name": "x-csrf-token",
              "header_value": "CSRF-TOKEN"
            }
          ]
        }
      ],
      "prerequisites": [
        {
          "type": "login",
          "description": "Obtain authenticated session via form_login to access upload endpoint",
          "bind_to": "session",
          "custom_logic": "perform login flow and store session cookie"
        },
        {
          "type": "csrf_token",
          "description": "Capture CSRF token value for double submit",
          "extract_from": "cookie:CSRF-TOKEN",
          "bind_to": "csrf",
          "custom_logic": "read CSRF-TOKEN cookie and set x-csrf-token header with same value"
        },
        {
          "type": "session_state",
          "description": "Maintain session cookie across requests",
          "extract_from": "set-cookie:session",
          "bind_to": "cookie_store",
          "custom_logic": "persist cookie jar"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "compare status vs baseline across header variants",
          "threshold": {
            "expected_codes": [
              200,
              201,
              202,
              204,
              400,
              401,
              403,
              415,
              422,
              500,
              413,
              405
            ]
          },
          "weight": 0.4
        },
        {
          "signal": "response_length_diff",
          "condition": "size delta >= threshold vs baseline",
          "threshold": {
            "body_length_delta_pct": 40.0
          },
          "weight": 0.3
        },
        {
          "signal": "error_signature",
          "condition": "look for parser and tmp path leaks",
          "threshold": {
            "string_value": "boundary not found|unexpected end of multipart|Tmp file|TemporaryFile|/tmp/|C:\\\\Windows\\\\Temp|Stack trace|Traceback|IllegalStateException|MultipartException|Busboy|multer|werkzeug|PHP Warning|PHP Notice"
          },
          "weight": 0.3
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 5
      },
      "max_retries": 1,
      "delay_between_requests": 0.5,
      "notes": "Send minimal bodies to avoid actual uploads. For JSON or malformed types, send empty body.",
      "tags": [
        "sensitive_data_exposure",
        "content-type-mismatch",
        "csrf-protected"
      ],
      "estimated_duration": 2
    },
