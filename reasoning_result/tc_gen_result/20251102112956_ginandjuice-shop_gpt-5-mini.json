          "header": [
            {
              "header_name": "User-Agent",
              "header_value": "Mozilla/5.0 (compatible)"
            }
          ]
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "Look for exact token SCAN_REFLECT_zz99 in response body or headers on HTTP 200 responses. If present unescaped, signal reflection.",
          "threshold": {
            "expected_codes": [
              200
            ],
            "string_value": "SCAN_REFLECT_zz99"
          },
          "weight": 1.0
