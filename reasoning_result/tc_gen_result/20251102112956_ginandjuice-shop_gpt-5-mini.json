    {
      "id": "TC-H009-csrf-token-handling",
      "hypothesis_id": "H009",
      "base_url": "https://{{host}}",
      "method": "POST",
      "endpoint": "/catalog/subscribe",
      "parameter": "csrf",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "body.email",
              "value": "test@example.com"
            },
            {
              "location": "body.coupon",
              "value": ""
            },
            {
              "location": "body.csrf",
              "value": "FETCHED_CSRF_TOKEN"
            }
          ],
          "description": "Baseline valid subscription POST including valid CSRF token and benign email. 'FETCHED_CSRF_TOKEN' must be obtained via prerequisite step.",
          "encoding": "json",
          "content_type": "application/json",
          "header": [
            {
              "header_name": "Content-Type",
              "header_value": "application/json;charset=UTF-8"
            },
            {
              "header_name": "User-Agent",
              "header_value": "Mozilla/5.0 (compatible)"
            },
            {
              "header_name": "Cookie",
              "header_value": "SESSION=VALID_SESSION_COOKIE"
            }
          ]
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body.email",
              "value": "test@example.com"
            },
            {
              "location": "body.coupon",
              "value": ""
            },
            {
              "location": "body.csrf",
              "value": ""
            }
          ],
          "description": "Probe with missing CSRF token to observe status code and error behaviour",
          "encoding": "json",
          "content_type": "application/json",
          "header": [
            {
              "header_name": "Content-Type",
              "header_value": "application/json;charset=UTF-8"
            },
            {
              "header_name": "User-Agent",
              "header_value": "Mozilla/5.0 (compatible)"
            },
            {
              "header_name": "Cookie",
              "header_value": "SESSION=VALID_SESSION_COOKIE"
            }
          ]
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "body.email",
              "value": "test@example.com"
            },
            {
              "location": "body.coupon",
              "value": ""
            },
            {
              "location": "body.csrf",
              "value": "INVALID_TOKEN"
            }
          ],
          "description": "Probe with explicitly invalid CSRF token to elicit CSRF-specific errors. Do not use real accounts for side-effects.",
          "encoding": "json",
          "content_type": "application/json",
          "header": [
            {
              "header_name": "Content-Type",
              "header_value": "application/json;charset=UTF-8"
            },
            {
              "header_name": "User-Agent",
              "header_value": "Mozilla/5.0 (compatible)"
            },
            {
              "header_name": "Cookie",
              "header_value": "SESSION=VALID_SESSION_COOKIE"
            }
          ]
        }
      ],
      "prerequisites": [
        {
          "type": "login",
          "description": "Obtain valid authenticated session cookie for endpoints protected by cookie auth."
        },
        {
          "type": "csrf_token",
          "description": "Fetch valid CSRF token by performing GET on /catalog or retrieving form token from page; bind token to body.csrf in baseline payload.",
          "extract_from": "/catalog (GET) response body form input named csrf",
          "bind_to": "body.csrf"
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "Compare status code of baseline (valid CSRF) with missing and invalid token probes. If missing or invalid token requests return codes in [400,401,403] while baseline returns 200/201, flag as CSRF protection present.",
          "threshold": {
            "expected_codes": [
              200,
              201,
              400,
              401,
              403
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "error_signature",
          "condition": "Inspect response body for CSRF-specific error messages (e.g., 'CSRF', 'invalid token', 'missing token', 'forbidden'). If present for probe requests and absent for baseline, flag as CSRF enforcement.",
          "threshold": {
            "expected_codes": [
              400,
              403
            ]
          },
          "weight": 1.0
        }
      ],
      "pass_logic": "all",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 6
      },
      "max_retries": 2,
      "delay_between_requests": 1.0,
      "notes": "Prerequisite steps must extract a live CSRF token and a valid session cookie before executing baseline. Do not exceed max_requests. Use non-privileged test email.",
      "tags": [
        "csrf",
        "state-changing"
      ],
      "estimated_duration": 300
    }
