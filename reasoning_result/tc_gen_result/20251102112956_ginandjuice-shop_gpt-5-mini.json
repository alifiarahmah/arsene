      "max_retries": 1,
      "delay_between_requests": 0.5,
      "notes": "scanMeHeader may be used by client scripts; observe both body and headers. Use benign baseline first.",
      "tags": [
        "xss",
        "reflected"
      ],
      "estimated_duration": 45
    },
