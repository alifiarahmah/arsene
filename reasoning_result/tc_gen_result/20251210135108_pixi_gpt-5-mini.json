            {
              "location": "body",
              "value": "filename=test.txt\r\nContent-Type: text/plain\r\n\r\ntest-content"
            }
          ],
          "description": "Upload a small benign text file as multipart to observe server handling and error messages.",
          "encoding": "multipart/form-data",
          "content_type": "multipart/form-data; boundary=----WebKitFormBoundaryUzCwPZQIC5FBFc1k",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "body",
              "value": "filename=../etc/passwd\r\nContent-Type: text/plain\r\n\r\n../../etc/passwd"
            }
          ],
          "description": "Path-traversal style filename to trigger server-side errors or inclusion attempts (benign payload).",
          "encoding": "multipart/form-data",
          "content_type": "multipart/form-data; boundary=----WebKitFormBoundaryUzCwPZQIC5FBFc1k",
          "header": []
        }
      ],
      "prerequisites": [
        {
          "type": "custom",
          "description": "If auth required, include valid session cookie or token; if CSRF required include valid token",
          "custom_logic": "Retry with and without auth/CSRF to observe differences"
        }
      ],
      "oracle_rules": [
        {
          "signal": "error_signature",
          "condition": "Server returns 4xx/5xx with stack trace or detailed error message referencing file handling",
