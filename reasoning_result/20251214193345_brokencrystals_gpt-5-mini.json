            {
              "location": "Referer",
              "value": "https://attacker.example/alt"
            },
            {
              "location": "Upgrade-Insecure-Requests",
              "value": "0"
            }
          ],
          "description": "Alter pb to a different region and headers to detect response size/status changes.",
          "content_type": "text/html",
          "header": [
            {
              "header_name": "Referer",
              "header_value": "https://attacker.example/alt"
            },
            {
              "header_name": "Upgrade-Insecure-Requests",
              "header_value": "0"
            }
          ]
        }
