    {
      "id": "tc_chain_4_api_config_enum",
      "hypothesis_id": "h12",
      "base_url": "https://brokencrystals.com",
      "method": "GET",
      "endpoint": "/api/config",
      "parameter": "id",
      "payloads": [
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "id",
              "value": "1"
            }
          ],
          "description": "Initial /api/config?id=1 to capture baseline response code and body",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "id",
              "value": "0"
            }
          ],
          "description": "/api/config?id=0 to test for default behavior or special-case",
          "content_type": "application/json",
          "header": []
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "id",
              "value": "9999"
            }
          ],
          "description": "High id value to detect enumeration differences (404/403/200) and data exposure",
          "content_type": "application/json",
          "header": []
        }
      ],
      "prerequisites": [
        {
          "type": "custom",
          "description": "Include any session cookie or auth header observed from baseline; if endpoint requires auth, set needs_observation=true and stop further enumeration until authenticated."
        }
      ],
      "oracle_rules": [
        {
          "signal": "status_code_change",
          "condition": "status_varies_across_ids",
          "threshold": {
            "expected_codes": [
              200,
              404,
              403
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "body_size_varies_significantly",
          "threshold": {
            "body_length_delta_pct": 40.0
          },
          "weight": 1.0
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 100
      },
      "max_retries": 2,
      "delay_between_requests": 0.2,
      "notes": "High-impact enumeration of config endpoint. If responses indicate unauthorized (403) for all ids, stop and mark needs_observation. If 200 returns with config fields, inspect for sensitive data exposure.",
      "tags": [
        "idor",
        "resource-enumeration",
        "sensitive-data-exposure"
      ],
      "estimated_duration": 5
    },
    {
