    {
      "id": "plan-6-upload-robustness",
      "hypothesis_id": "hyp-POST-27-content-type-robustness",
      "base_url": "http://localhost:8000",
      "method": "POST",
      "endpoint": "27",
      "parameter": "Content-Type",
      "payloads": [
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "header.Content-Type",
              "value": "multipart/form-data; boundary=----WebKitFormBoundaryAAAAAA"
            }
          ],
          "description": "Alter multipart boundary to short predictable value",
          "header": [
            {
              "header_name": "Referer",
              "header_value": "http://localhost:8000/pixi"
            }
          ]
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "header.Content-Type",
              "value": "multipart/form-data;boundary=----WebKitFormBoundaryBBBBBBBB"
            }
          ],
          "description": "No space before boundary parameter",
          "header": [
            {
              "header_name": "Referer",
              "header_value": "http://localhost:8000/pixi"
            }
          ]
        },
        {
          "tier": "probe",
          "payloads": [
            {
              "location": "header.Content-Type",
              "value": "text/plain"
            }
          ],
          "description": "Wrong content-type to trigger 415/400",
          "header": [
            {
              "header_name": "Referer",
              "header_value": "http://localhost:8000/pixi"
            }
          ]
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "error_signature",
          "condition": "status in [400,415,500] or any(e in body for e in [\"multipart\",\"boundary\",\"parse\",\"invalid\",\"error\"])",
          "threshold": {
            "expected_codes": [
              400,
              415,
              500
            ]
          },
          "weight": 1.0
        },
        {
          "signal": "status_code_change",
          "condition": "exists_prior_status and status != prior_status and status in [200,201,204,400,415,500]",
          "threshold": {
            "expected_codes": [
              200,
              201,
              204,
              400,
              415,
              500
            ]
          },
          "weight": 0.5
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": false,
        "destructive_ok": false,
        "max_requests": 3
      },
      "max_retries": 1,
      "delay_between_requests": 0.3,
      "notes": "Stop this group if any 500 observed to reduce risk",
      "tags": [
        "robustness",
        "upload"
      ],
      "estimated_duration": 2
    },
