      "base_url": "https://ginandjuice.shop",
      "method": "GET",
      "endpoint": "/catalog/cart",
      "parameter": "scanMeHeader",
      "payloads": [
        {
          "tier": "benign",
          "payloads": [
            {
              "location": "header",
              "value": "scanMeHeader: https://ginandjuice.shop/catalog"
            }
          ],
          "description": "Establish session cookie and retrieve CSRF if present",
          "header": [
            {
              "header_name": "referer",
              "header_value": "https://ginandjuice.shop/catalog"
            },
            {
              "header_name": "upgrade-insecure-requests",
              "header_value": "1"
            },
            {
              "header_name": "user-agent",
              "header_value": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/140.0.0.0 Safari/537.36"
            },
            {
              "header_name": "sec-ch-ua",
              "header_value": "\"Chromium\";v=\"140\", \"Not=A?Brand\";v=\"24\", \"Google Chrome\";v=\"140\""
            },
            {
              "header_name": "sec-ch-ua-mobile",
              "header_value": "?0"
            },
            {
              "header_name": "sec-ch-ua-platform",
              "header_value": "\"Windows\""
            }
          ]
        }
      ],
      "prerequisites": [],
      "oracle_rules": [
        {
          "signal": "header_change",
          "condition": "Set-Cookie issued for session",
          "weight": 1.0
        },
        {
          "signal": "response_length_diff",
          "condition": "Body non-empty to allow CSRF parsing",
          "threshold": {
            "body_length_delta_pct": 1.0
          },
          "weight": 0.3
        }
      ],
      "pass_logic": "any",
      "safety": {
        "idempotent_required": true,
        "destructive_ok": false,
        "max_requests": 1
      },
      "max_retries": 1,
      "delay_between_requests": 0.2,
      "notes": "Bootstrap session and potential CSRF for subsequent POST tests",
      "tags": [
        "bootstrap",
        "session",
        "csrf"
      ],
      "estimated_duration": 1
    },
